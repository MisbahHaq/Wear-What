@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager? Navigation

<section class="nb-page" aria-label="American Tall neo-brutalist bento grid">
    <nav class="nb-nav" aria-label="Primary navigation">
        <div class="nb-nav-inner">
            <button class="nb-hamburger" type="button" aria-label="Open menu" aria-expanded="@menuOpen.ToString().ToLowerInvariant()" @onclick="ToggleMenu">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="nb-menu @MenuClass">
                <a href="/" @onclick='() => NavigateTo("/")' @onclick:preventDefault class="nb-link">HOME</a>
                <a href="/products" @onclick='() => NavigateTo("/products")' @onclick:preventDefault class="nb-link">PRODUCTS</a>
                <a href="/collections" @onclick='() => NavigateTo("/collections")' @onclick:preventDefault class="nb-link nb-link-dropdown">COLLECTIONS <span aria-hidden="true">▼</span></a>
                <a href="/contact" @onclick='() => NavigateTo("/contact")' @onclick:preventDefault class="nb-link">CONTACT</a>
            </div>

            <form class="nb-search" role="search" @onsubmit="HandleSearch">
                <label class="nb-sr-only" for="nb-search-input">Search products</label>
                <input id="nb-search-input" class="nb-search-input" type="search" placeholder="SEARCH" autocomplete="off" @bind="searchQuery" />
                <button class="nb-search-button" type="submit" aria-label="Search">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M10.75 18.5a7.75 7.75 0 1 1 0-15.5 7.75 7.75 0 0 1 0 15.5Zm0-2.25a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm6.1 1.1 4.4 4.4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                    </svg>
                </button>
            </form>
        </div>
    </nav>

    <main class="nb-bento">
        <article class="nb-panel nb-top" aria-label="American Tall water bottle">
            <img class="nb-image nb-top-image" src="https://via.placeholder.com/720x720/050505/FFFFFF?text=AMERICAN+TALL+BOTTLE" alt="Close-up cropped black water bottle" />
            <div class="nb-top-title">AMERICAN<br />TALL</div>
            <div class="nb-top-stack">WATER<br />BOTTLE</div>
            <div class="nb-accent">
                <span>NEXT DROP</span>
                <button class="nb-arrow" type="button" aria-label="View next drop">&gt;</button>
            </div>
        </article>

        <article class="nb-panel nb-right" aria-label="Black water bottle with white giraffe graphic">
            <img class="nb-image nb-right-image" src="https://via.placeholder.com/520x1000/050505/FFFFFF?text=GIRAFFE+WATER+BOTTLE" alt="Black water bottle featuring a white giraffe graphic" />
        </article>

        <article class="nb-panel nb-promo" aria-label="Twenty percent off promotion">
            <div class="nb-promo-inner">
                <div>
                    <div class="nb-discount">20% OFF</div>
                    <div class="nb-subtitle">on all the products / shop it now</div>
                </div>
                <button class="nb-shop-card" type="button" @onclick="ShopAllProducts">
                    <span>SHOP ALL PRODUCTS</span>
                    <svg class="nb-cart" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M6.5 6.5h14l-1.4 7.8H7.8L6.5 6.5Z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
                        <path d="M9 20.25a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8Zm8.2 0a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8Z" fill="currentColor" />
                    </svg>
                </button>
            </div>
        </article>

        <article class="nb-panel nb-preview" aria-label="New folded t-shirt preview">
            <div class="nb-shirts">
                <img class="nb-shirt nb-shirt-back" src="https://via.placeholder.com/220x160/050505/FFFFFF?text=BLACK+TEE" alt="Folded black t-shirt" />
                <img class="nb-shirt nb-shirt-front" src="https://via.placeholder.com/220x160/EEEEEE/000000?text=WHITE+TEE" alt="Folded white t-shirt" />
            </div>
            <div class="nb-preview-text">CHECK OUT THE NEW STUFF</div>
        </article>

        <button class="nb-intersect" type="button" aria-label="Add to cart or quick view" @onclick="AddToCart">
            <span aria-hidden="true">+</span>
        </button>
    </main>
</section>

@code {
    private bool menuOpen;
    private string? searchQuery;

    private string MenuClass => menuOpen ? "is-open" : string.Empty;

    [Parameter] public EventCallback OnAddToCart { get; set; }
    [Parameter] public EventCallback OnShopAllProducts { get; set; }
    [Parameter] public EventCallback<string> OnNavigate { get; set; }
    [Parameter] public EventCallback<string> OnSearch { get; set; }

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    private async Task AddToCart()
    {
        if (OnAddToCart.HasDelegate)
        {
            await OnAddToCart.InvokeAsync();
        }
    }

    private async Task ShopAllProducts()
    {
        if (OnShopAllProducts.HasDelegate)
        {
            await OnShopAllProducts.InvokeAsync();
            return;
        }

        await NavigateTo("/products");
    }

    private async Task HandleSearch()
    {
        if (OnSearch.HasDelegate)
        {
            await OnSearch.InvokeAsync(searchQuery?.Trim() ?? string.Empty);
        }
    }

    private async Task NavigateTo(string route)
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync(route);
            return;
        }

        Navigation?.NavigateTo(route);
    }
}
