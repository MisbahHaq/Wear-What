@model IEnumerable<Shop.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="category-strip">
    <nav class="nav justify-content-center flex-nowrap overflow-auto px-3">
        @{
            var currentCategoryId = Context.Request.Query["categoryId"].ToString() ?? "";
        }
        
        <a asp-action="Index" 
           asp-route-categoryId="" 
           class="nav-link @(string.IsNullOrEmpty(currentCategoryId) ? "text-dark fw-bold" : "")">
            All Categories
        </a>

        @foreach (var cat in ViewBag.CategoryId as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>())
        {
            bool isSelected = !string.IsNullOrEmpty(currentCategoryId) && currentCategoryId == cat.Value;
            
            <a asp-action="Index" 
               asp-route-categoryId="@cat.Value" 
               class="nav-link @(isSelected ? "text-dark fw-bold" : "")">
                @cat.Text
            </a>
        }
    </nav>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Products</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary">Create Product</a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert">No products found.</div>
}
else
{
    <div class="product-grid">
    @foreach (var item in Model)
    {
        <a asp-action="Details" asp-route-id="@item.Id" class="product-card text-decoration-none">
            @if (!string.IsNullOrEmpty(item.ImageUrl1))
            {
                <img src="@item.ImageUrl1" class="product-card-image" alt="@item.Name" />
            }
            else
            {
                <div class="product-card-image-placeholder">@(item.Name.Length > 0 ? item.Name[0].ToString().ToUpper() : "?")</div>
            }
            <div class="product-card-body">
                <div class="product-card-title">@item.Name</div>
                <div class="product-card-description">@item.Description</div>
                <div class="product-card-price">$@item.Price.ToString("0.00")</div>
                <div class="product-card-shop">@item.Shop?.Name</div>
                <span class="btn btn-outline-primary btn-sm product-card-btn">Details</span>
            </div>
        </a>
    }
    </div>
}
