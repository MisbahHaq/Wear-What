@model IEnumerable<Shop.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="category-strip">
    <nav class="nav justify-content-center flex-nowrap overflow-auto px-3">
        @{
            var currentCategoryId = Context.Request.Query["categoryId"].ToString() ?? "";
        }
        
        <a asp-action="Index" 
           asp-route-categoryId="" 
           class="nav-link @(string.IsNullOrEmpty(currentCategoryId) ? "text-dark fw-bold" : "")">
            All Categories
        </a>

        @foreach (var cat in ViewBag.CategoryId as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>())
        {
            bool isSelected = !string.IsNullOrEmpty(currentCategoryId) && currentCategoryId == cat.Value;
            
            <a asp-action="Index" 
               asp-route-categoryId="@cat.Value" 
               class="nav-link @(isSelected ? "text-dark fw-bold" : "")">
                @cat.Text
            </a>
        }
    </nav>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Products</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary">Create Product</a>
    }
</div>

<form asp-action="Index" method="get" class="row g-2 mb-4 align-items-end">
    <div class="col-md-3">
        <label class="form-label small fw-bold">Search</label>
        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Search..." />
    </div>
    <div class="col-md-2">
        <label class="form-label small fw-bold">Min Price</label>
        <input type="number" step="0.01" name="minPrice" value="@ViewBag.MinPrice" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label small fw-bold">Max Price</label>
        <input type="number" step="0.01" name="maxPrice" value="@ViewBag.MaxPrice" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label small fw-bold">Min Rating</label>
        <select name="minRating" class="form-select">
            <option value="">Any</option>
            @for (int i = 1; i <= 5; i++)
            {
                <option value="@i" selected="@((ViewBag.MinRating as int?) == i)">@i ★ +</option>
            }
        </select>
    </div>
    <div class="col-md-2 form-check mt-4">
        <input type="checkbox" name="inStockOnly" value="true" class="form-check-input" @(ViewBag.InStockOnly == true ? "checked" : "") />
        <label class="form-check-label">In stock only</label>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-dark w-100">Filter</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert">No products found.</div>
}
else
{
    <div class="product-grid">
    @foreach (var item in Model)
    {
        <a asp-action="Details" asp-route-id="@item.Id" class="product-card text-decoration-none">
            @if (!string.IsNullOrEmpty(item.ImageUrl1))
            {
                <img src="@item.ImageUrl1" class="product-card-image" alt="@item.Name" />
            }
            else
            {
                 <div class="product-card-image-placeholder">@(!string.IsNullOrEmpty(item.Name) ? item.Name[0].ToString().ToUpper() : "?")</div>
            }
            <div class="product-card-body">
                <div class="product-card-title">@item.Name</div>
                <div class="product-card-description">@item.Description</div>
                <div class="product-card-price">$@item.Price.ToString("0.00")</div>
                <div class="product-card-shop">@item.Shop?.Name</div>
                @if (!item.IsAvailable)
                {
                    <div class="small text-danger">Out of stock</div>
                }
                else if (item.StockQuantity <= item.LowStockThreshold)
                {
                    <div class="small text-warning">Low stock (@item.StockQuantity)</div>
                }
                else
                {
                    <div class="small text-success">In stock (@item.StockQuantity)</div>
                }
                <span class="btn btn-outline-primary btn-sm product-card-btn">Details</span>
            </div>
        </a>
    }
    </div>
}
