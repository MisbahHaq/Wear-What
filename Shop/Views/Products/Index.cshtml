@model IEnumerable<Shop.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

@if (User.Identity?.IsAuthenticated == true)
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Product</a>
    </p>
}

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-auto">
        <label for="shopId" class="form-label">Shop</label>
        <select name="shopId" id="shopId" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Shops --</option>
            @foreach (var shop in ViewBag.Shops as IEnumerable<Shop.Models.ShopItem> ?? Enumerable.Empty<Shop.Models.ShopItem>())
            {
                <option value="@shop.Id" selected="@(ViewBag.SelectedShopId != null && ViewBag.SelectedShopId == shop.Id)">@shop.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label for="categoryId" class="form-label">Category</label>
        <select name="categoryId" id="categoryId" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Categories --</option>
            @foreach (var cat in ViewBag.CategoryId as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>())
            {
                <option value="@cat.Value" selected="@cat.Selected">@cat.Text</option>
            }
        </select>
    </div>
</form>

<div class="row">
@foreach (var item in Model) {
    <div class="col-md-4 mb-4">
        <div class="card">
            @if (!string.IsNullOrEmpty(item.ImageUrl1))
            {
                <img src="@item.ImageUrl1" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;" />
            }
            <div class="card-body">
                <h5 class="card-title">@item.Name</h5>
                <p class="card-text">@item.Description</p>
                <p class="card-text"><strong>$@item.Price.ToString("0.00")</strong></p>
                @if (item.Category != null)
                {
                    <p class="card-text"><small class="text-muted">Category: @item.Category.Name</small></p>
                }
                @if (!string.IsNullOrEmpty(item.Niche))
                {
                    <p class="card-text"><small class="text-muted">Niche: @item.Niche</small></p>
                }
                <p class="card-text"><small class="text-muted">Shop: <a asp-controller="Shops" asp-action="Details" asp-route-id="@item.ShopId">@item.Shop?.Name</a></small></p>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
            </div>
        </div>
    </div>
}
</div>