@model Shop.Models.Product

@{
    ViewData["Title"] = Model.Name;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<h1>@Model.Name</h1>

@if (Model.Category != null)
{
    <p><strong>Category:</strong> @Model.Category.Name</p>
}
@if (!string.IsNullOrEmpty(Model.Niche))
{
    <p><strong>Niche:</strong> @Model.Niche</p>
}

<div class="row">
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty(Model.ImageUrl1))
        {
            <img src="@Model.ImageUrl1" class="img-fluid mb-2" alt="Product Image 1" />
        }
        @if (!string.IsNullOrEmpty(Model.ImageUrl2))
        {
            <img src="@Model.ImageUrl2" class="img-fluid mb-2" alt="Product Image 2" />
        }
        @if (!string.IsNullOrEmpty(Model.ImageUrl3))
        {
            <img src="@Model.ImageUrl3" class="img-fluid mb-2" alt="Product Image 3" />
        }
        @if (!string.IsNullOrEmpty(Model.ImageUrl4))
        {
            <img src="@Model.ImageUrl4" class="img-fluid mb-2" alt="Product Image 4" />
        }
        @if (!string.IsNullOrEmpty(Model.ImageUrl5))
        {
            <img src="@Model.ImageUrl5" class="img-fluid mb-2" alt="Product Image 5" />
        }
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Description</h5>
                <p class="card-text">@Model.Description</p>
                <h5 class="card-title">Price</h5>
                <p class="card-text"><strong>$@Model.Price.ToString("0.00")</strong></p>
                <h5 class="card-title">Shop</h5>
                <p class="card-text"><a asp-controller="Shops" asp-action="Details" asp-route-id="@Model.ShopId">@Model.Shop?.Name</a></p>
                @if (Model.Shop?.OwnerId == currentUserId)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                }
                else if (currentUserId != null)
                {
                    <form asp-controller="Wishlist" asp-action="Add" method="post" class="d-inline" asp-antiforgery="true">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-primary">Add to Wishlist</button>
                    </form>
                }
                <a asp-action="Index" class="btn btn-secondary">Back to Products</a>
            </div>
        </div>
    </div>
</div>

@if (Model.Comments.Any())
{
    <hr />
    <h3>Reviews</h3>
    <div class="list-group">
        @foreach (var comment in Model.Comments!)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between">
                    <h5>@comment.User?.FullName</h5>
                    <span class="text-warning">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= comment.Rating)
                            {
                                <span>&#9733;</span>
                            }
                            else
                            {
                                <span>&#9734;</span>
                            }
                        }
                    </span>
                </div>
                <p class="mb-1">@comment.Content</p>
                <small class="text-muted">@comment.CreatedAt.ToString("g")</small>
                @if (comment.UserId == currentUserId)
                {
                    <div class="mt-2">
                        <a asp-controller="Comments" asp-action="Edit" asp-route-id="@comment.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-controller="Comments" asp-action="Delete" asp-route-id="@comment.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </div>
                }
            </div>
        }
    </div>
}

@if (currentUserId != null)
{
    <hr />
    <a asp-controller="Comments" asp-action="Create" asp-route-productId="@Model.Id" class="btn btn-primary">Add Review</a>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}