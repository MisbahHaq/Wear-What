@model IEnumerable<Shop.Models.ShopCategory>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Categories</h1>
    <a asp-action="Create" class="btn btn-primary">Create Category</a>
</div>

<div class="product-grid">
@foreach (var item in Model)
{
    <a asp-action="Edit" asp-route-id="@item.Id" class="product-card text-decoration-none">
        <div class="product-card-body">
            <div class="product-card-title">@item.Name</div>
            <span class="btn btn-outline-primary btn-sm product-card-btn">Edit</span>
        </div>
    </a>
}
</div>
