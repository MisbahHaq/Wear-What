@using Shop.Models
@model Shop.Models.CartCheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="container checkout-container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb text-muted sm">
            <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index" class="text-decoration-none text-muted">Cart</a></li>
            <li class="breadcrumb-item active" aria-current="page">Checkout</li>
        </ol>
    </nav>

    <h2 class="fw-bold mb-4">Confirm Your Order</h2>

    <div class="row g-5">
        <div class="col-lg-7">
            <div class="card border-0 bg-light p-3 mb-4" style="border-radius: 12px;">
                <h5 class="fw-bold mb-3">Items (@Model.Items.Count)</h5>
                @foreach (var item in Model.Items)
                {
                    var img = !string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : "/images/placeholder.png";
                    <div class="d-flex gap-3 align-items-center mb-3">
                        <div class="checkout-summary-img">
                            <img src="@img" alt="@item.ProductName" />
                        </div>
                        <div class="flex-grow-1">
                            <div class="text-success text-uppercase small fw-bold">@(item.ShopName ?? "Shop")</div>
                            <div class="checkout-product-title">@item.ProductName</div>
                            <div class="text-muted small">$@item.UnitPrice.ToString("0.00") x @item.Quantity</div>
                        </div>
                        <div class="text-end">
                            <div class="checkout-price">$@item.Total.ToString("0.00")</div>
                        </div>
                    </div>
                }
            </div>

            <form asp-controller="Orders" asp-action="CreateCart" method="post" asp-antiforgery="true">
                <h5 class="fw-bold mb-3">Shipping Information</h5>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Full Name</label>
                    <input type="text" class="form-control" value="@Model.CustomerFullName" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="contactNumber">Contact Number</label>
                    <input type="text" class="form-control" id="contactNumber" name="contactNumber" value="@Model.CustomerContactNumber" placeholder="Enter your contact number" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="shippingAddress">Shipping Address</label>
                    <textarea class="form-control" id="shippingAddress" name="shippingAddress" rows="3" placeholder="Enter your full shipping address">@Model.ShippingAddress</textarea>
                </div>

                <h5 class="fw-bold mb-3 mt-4">Delivery Method</h5>
                <div class="d-flex flex-column gap-2">
                    <label class="option-card @(Model.DeliveryMethod != "Express" ? "active" : "")">
                        <input class="form-check-input" type="radio" name="deliveryMethod" value="Standard" data-fee="0" @(Model.DeliveryMethod != "Express" ? "checked" : "") />
                        <span class="flex-grow-1">
                            <span class="fw-semibold d-block">Standard Delivery</span>
                            <span class="text-muted small">Arrives in 5-7 business days</span>
                        </span>
                        <span class="fw-semibold">Free</span>
                    </label>
                    <label class="option-card @(Model.DeliveryMethod == "Express" ? "active" : "")">
                        <input class="form-check-input" type="radio" name="deliveryMethod" value="Express" data-fee="150" @(Model.DeliveryMethod == "Express" ? "checked" : "") />
                        <span class="flex-grow-1">
                            <span class="fw-semibold d-block">Express Delivery</span>
                            <span class="text-muted small">Arrives in 1-2 business days</span>
                        </span>
                        <span class="fw-semibold">$@CartCheckoutViewModel.ExpressDeliveryFee</span>
                    </label>
                </div>

                <h5 class="fw-bold mb-3 mt-4">Payment Method</h5>
                <div class="d-flex flex-column gap-2">
                    <label class="option-card @(Model.PaymentMethod != "Card" ? "active" : "")">
                        <input class="form-check-input" type="radio" name="paymentMethod" value="CashOnDelivery" @(Model.PaymentMethod != "Card" ? "checked" : "") />
                        <span class="flex-grow-1">
                            <span class="fw-semibold d-block">Cash on Delivery</span>
                            <span class="text-muted small">Pay when you receive your order</span>
                        </span>
                    </label>
                    <label class="option-card @(Model.PaymentMethod == "Card" ? "active" : "")">
                        <input class="form-check-input" type="radio" name="paymentMethod" value="Card" @(Model.PaymentMethod == "Card" ? "checked" : "") />
                        <span class="flex-grow-1">
                            <span class="fw-semibold d-block">Credit / Debit Card</span>
                            <span class="text-muted small">Demo only — no real charge</span>
                        </span>
                    </label>
                </div>

                <div class="payment-fields border rounded p-3 bg-light mt-2" id="cardFields">
                    <div class="mb-2">
                        <label class="form-label fw-semibold small">Card Number</label>
                        <input type="text" class="form-control" name="cardNumber" placeholder="4242 4242 4242 4242" />
                    </div>
                    <div class="row">
                        <div class="col-6 mb-2">
                            <label class="form-label fw-semibold small">Expiry</label>
                            <input type="text" class="form-control" name="cardExpiry" placeholder="MM/YY" />
                        </div>
                        <div class="col-6 mb-2">
                            <label class="form-label fw-semibold small">CVC</label>
                            <input type="text" class="form-control" name="cardCvc" placeholder="123" />
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-dark px-4">Back</a>
                    <button type="submit" class="btn-confirm-order flex-grow-1">Confirm & Place Order</button>
                </div>
            </form>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 bg-light p-4" style="border-radius: 12px; position: sticky; top: 1.5rem;">
                <h5 class="fw-bold mb-3">Order Summary</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Subtotal (@Model.Items.Sum(i => i.Quantity) items)</span>
                    <span>$@Model.ProductsSubtotal.ToString("0.00")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Delivery</span>
                    <span class="text-muted" id="summaryDelivery">$@Model.DeliveryFee.ToString("0.00")</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <span class="fw-bold">Total</span>
                    <span class="fw-bold fs-5" id="summaryTotal">$@Model.Total.ToString("0.00")</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var expressFee = @CartCheckoutViewModel.ExpressDeliveryFee;
        var subtotal = @Model.ProductsSubtotal;

        function updateOptionCards() {
            document.querySelectorAll('.option-card').forEach(function (card) {
                var input = card.querySelector('input[type="radio"]');
                if (input && input.checked) card.classList.add('active');
                else card.classList.remove('active');
            });
        }

        function updateSummary() {
            var delivery = 0;
            var deliveryInput = document.querySelector('input[name="deliveryMethod"]:checked');
            if (deliveryInput) delivery = parseFloat(deliveryInput.dataset.fee) || 0;

            var total = subtotal + delivery;
            document.getElementById('summaryDelivery').textContent = '$' + delivery.toFixed(2);
            document.getElementById('summaryTotal').textContent = '$' + total.toFixed(2);

            var cardInput = document.querySelector('input[name="paymentMethod"]:checked');
            var showCard = cardInput && cardInput.value === 'Card';
            document.getElementById('cardFields').style.display = showCard ? 'block' : 'none';
        }

        document.querySelectorAll('input[type="radio"]').forEach(function (input) {
            input.addEventListener('change', function () {
                updateOptionCards();
                updateSummary();
            });
        });

        updateSummary();
    </script>
}
