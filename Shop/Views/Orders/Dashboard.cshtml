@model OwnerDashboardViewModel

@{
    ViewData["Title"] = "Owner Dashboard";
    var ordersByOrder = Model.OrderItems
        .GroupBy(i => i.OrderId)
        .OrderByDescending(g => g.First().Order!.CreatedAt);
}

<h1>Owner Dashboard</h1>

@if (TempData["OrderMessage"] != null)
{
    <div class="alert alert-success">@TempData["OrderMessage"]</div>
}

@if (!Model.Shops.Any())
{
    <div class="alert alert-info">
        You do not have a shop yet. <a asp-controller="Shops" asp-action="Create">Create a shop</a> to start receiving orders.
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Shops</h5>
                    <p class="display-6">@Model.Shops.Count</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Orders</h5>
                    <p class="display-6">@ordersByOrder.Count()</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Total Sales</h5>
                    <p class="display-6">$@Model.TotalSales.ToString("0.00")</p>
                </div>
            </div>
        </div>
    </div>

    <h2>Your Shops</h2>
    <div class="list-group mb-4">
        @foreach (var shop in Model.Shops)
        {
            <a asp-controller="Shops" asp-action="Details" asp-route-id="@shop.Id" class="list-group-item list-group-item-action">
                <h5 class="mb-1">@shop.Name</h5>
                <p class="mb-1 text-muted">@shop.Description</p>
            </a>
        }
    </div>

    <h2>Orders</h2>
    @if (ordersByOrder.Any())
    {
        @foreach (var group in ordersByOrder)
        {
            var order = group.First().Order!;
            var orderTotal = group.Sum(i => i.UnitPrice * i.Quantity);

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Order #@group.Key</strong>
                        <span class="text-muted"> - @order.Status - @order.CreatedAt.ToString("g")</span>
                    </div>
                    <span class="badge bg-dark">$@orderTotal.ToString("0.00")</span>
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>Customer:</strong> @(order.Customer?.FullName ?? order.Customer?.UserName ?? order.CustomerId)</p>
                    <p class="mb-3"><strong>Shipping Address:</strong> @order.ShippingAddress</p>
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Shop</th>
                                    <th>Quantity</th>
                                    <th>Unit Price</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group)
                                {
                                    <tr>
                                        <td>@item.Product?.Name</td>
                                        <td>@item.Product?.Shop?.Name</td>
                                        <td>@item.Quantity</td>
                                        <td>$@item.UnitPrice.ToString("0.00")</td>
                                        <td>$@(item.UnitPrice * item.Quantity).ToString("0.00")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">No orders have been placed for your products yet.</div>
    }
}
