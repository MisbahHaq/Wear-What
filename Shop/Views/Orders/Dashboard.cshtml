@model OwnerDashboardViewModel

@{
    ViewData["Title"] = "Owner Dashboard";
    var ordersByOrder = Model.OrderItems
        .GroupBy(i => i.OrderId)
        .OrderByDescending(g => g.First().Order!.CreatedAt);
}

<style>
    .status-select {
        border: 1px solid var(--border);
        padding: 0.35rem 0.6rem;
        font-size: 0.82rem;
        font-weight: 600;
        background: var(--bg);
        color: var(--text);
        border-radius: 0;
        min-width: 160px;
    }

    .status-select:focus {
        border-color: var(--text);
        box-shadow: none;
        outline: none;
    }
</style>

<h1 class="fw-bold" style="font-size:1.4rem; border-bottom:2px solid var(--text); padding-bottom:0.75rem; margin-bottom:1.25rem;">Owner Dashboard</h1>

@if (TempData["OrderMessage"] != null)
{
    <div class="alert alert-success">@TempData["OrderMessage"]</div>
}

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-dark">@TempData["StatusMessage"]</div>
}

@if (!Model.Shops.Any() && (ViewBag.IsVendor ?? false))
{
    <div class="alert alert-info">
        You do not have a shop yet. <a asp-controller="Shops" asp-action="Create">Create a shop</a> to start receiving orders.
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Shops</h5>
                    <p class="display-6">@Model.Shops.Count</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Orders</h5>
                    <p class="display-6">@ordersByOrder.Count()</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Total Sales</h5>
                    <p class="display-6">$@Model.TotalSales.ToString("0.00")</p>
                </div>
            </div>
        </div>
    </div>

    @if (ViewBag.LowStockProducts != null && ((IEnumerable<Shop.Models.Product>)ViewBag.LowStockProducts).Any())
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center">
            <span><strong>Low stock alert:</strong> You have @((ViewBag.LowStockProducts as IEnumerable<Product>)!.Count(p => p.StockQuantity == 0)) out-of-stock and @((ViewBag.LowStockProducts as IEnumerable<Product>)!.Count(p => p.StockQuantity > 0)) low-stock products.</span>
            <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-dark">View Products</a>
        </div>
    }

    <h2>Your Shops</h2>
    <div class="list-group mb-4">
        @foreach (var shop in Model.Shops)
        {
            <a asp-controller="Shops" asp-action="Details" asp-route-id="@shop.Id" class="list-group-item list-group-item-action">
                <h5 class="mb-1">@shop.Name</h5>
                <p class="mb-1 text-muted">@shop.Description</p>
            </a>
        }
    </div>

    <a asp-action="Analytics" class="btn btn-outline-dark mb-4">View Sales Analytics</a>

    <h2>Orders</h2>
    @if (ordersByOrder.Any())
    {
        @foreach (var group in ordersByOrder)
        {
            var order = group.First().Order!;
            var orderTotal = group.Sum(i => i.UnitPrice * i.Quantity);

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Order #@group.Key</strong>
                        <span class="text-muted"> - @order.CreatedAt.ToString("g")</span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <form asp-action="UpdateOrderStatus" method="post" class="d-inline">
                            <input type="hidden" name="orderItemId" value="@group.First().Id" />
                            <select name="status" class="form-select status-select" onchange="this.form.submit()">
                                @foreach (var s in new[] { "Placed", "Confirmed", "Processing", "Shipped", "OutForDelivery", "Delivered", "Cancelled", "ReturnRequested", "Returned" })
                                {
                                    <option value="@s" selected="@(order.Status == s ? "selected" : null)">@s</option>
                                }
                            </select>
                            @Html.AntiForgeryToken()
                        </form>
                        <span class="badge bg-dark">$@orderTotal.ToString("0.00")</span>
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>Customer:</strong> @(order.Customer?.FullName ?? order.Customer?.UserName ?? order.CustomerId)</p>
                    <p class="mb-3"><strong>Shipping Address:</strong> @order.ShippingAddress</p>
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Shop</th>
                                    <th>Quantity</th>
                                    <th>Unit Price</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group)
                                {
                                    <tr>
                                        <td>@item.Product?.Name</td>
                                        <td>@item.Product?.Shop?.Name</td>
                                        <td>@item.Quantity</td>
                                        <td>$@item.UnitPrice.ToString("0.00")</td>
                                        <td>$@(item.UnitPrice * item.Quantity).ToString("0.00")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            No orders have been placed for your shop(s) yet.
            @if ((int)(ViewBag.CustomerOrderCount ?? 0) > 0)
            {
                <span>You have @ViewBag.CustomerOrderCount order(s) as a customer — see "Your Purchases" below.</span>
            }
        </div>
    }
}

@if (ViewBag.CustomerOrders != null && (int)(ViewBag.CustomerOrderCount ?? 0) > 0)
{
    var customerOrders = (System.Collections.Generic.IEnumerable<dynamic>)ViewBag.CustomerOrders;
    <h2 class="mt-5">Your Purchases</h2>
    <p class="text-muted small">These are orders you placed as a customer (not from your shop).</p>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Date</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var co in customerOrders)
                {
                    <tr>
                        <td>#@co.Id</td>
                        <td>@(((DateTime)co.CreatedAt).ToString("g"))</td>
                        <td>@co.ItemCount</td>
                        <td>$@(((decimal)co.TotalAmount).ToString("0.00"))</td>
                        <td>@co.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
