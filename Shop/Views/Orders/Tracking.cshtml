@model Shop.Models.OrderTrackingViewModel

@{
    ViewData["Title"] = "Order Tracking";
    var steps = new[] { "Placed", "Confirmed", "Processing", "Shipped", "OutForDelivery", "Delivered" };
    var currentStatus = Model.Order.Status;
    var currentIndex = Array.IndexOf(steps, currentStatus);
    if (currentIndex < 0) currentIndex = -1;
    var isCancelled = currentStatus == "Cancelled";
    var isReturned = currentStatus == "ReturnRequested" || currentStatus == "Returned";
}

<div class="container checkout-container" style="max-width: 900px;">
    <h2 class="fw-bold mb-4">Order #@Model.Order.Id - Tracking</h2>

    @if (TempData["OrderMessage"] != null)
    {
        <div class="alert alert-success">@TempData["OrderMessage"]</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Order Date</span>
                <span>@Model.Order.CreatedAt.ToString("g")</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Total</span>
                <span class="fw-bold">$@Model.Order.TotalAmount.ToString("0.00")</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Delivery</span>
                <span>@Model.Order.DeliveryMethod</span>
            </div>
        </div>
    </div>

    @if (!isCancelled && !isReturned)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Delivery Progress</h5>
                <div class="d-flex justify-content-between align-items-center position-relative" style="margin-top: 1rem;">
                    <div class="progress-line" style="position:absolute;top:15px;left:10%;right:10%;height:3px;background:#e9ecef;z-index:0;"></div>
                    <div class="progress-line-fill" style="position:absolute;top:15px;left:10%;height:3px;background:#198754;z-index:0;width:@(currentIndex >= 0 ? ((currentIndex + 1) / (double)(steps.Length - 1)) * 100 : 0)%;"></div>
                    @for (int i = 0; i < steps.Length; i++)
                    {
                        var active = i <= currentIndex;
                        <div class="d-flex flex-column align-items-center" style="position:relative;z-index:1;flex:1;">
                            <div style="width:32px;height:32px;border-radius:50%;background:@(active ? "#198754" : "#e9ecef");color:@(active ? "#fff" : "#6c757d");display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:0.8rem;">
                                @(active ? "&#10003;" : (i + 1).ToString())
                            </div>
                            <div class="small mt-2 text-center" style="font-size:0.75rem;max-width:80px;">@steps[i]</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (isCancelled)
    {
        <div class="alert alert-danger">This order has been cancelled.</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3">Status History</h5>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Time</th>
                            <th>Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.StatusHistory)
                        {
                            <tr>
                                <td><span class="badge bg-dark">@h.Status</span></td>
                                <td>@h.Timestamp.ToString("g")</td>
                                <td>@h.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-dark">Back to Orders</a>
        @if (currentStatus == "Placed" || currentStatus == "Confirmed")
        {
            <form asp-action="Cancel" asp-route-id="@Model.Order.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this order?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">Cancel Order</button>
            </form>
        }
    </div>
</div>
