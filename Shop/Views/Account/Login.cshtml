@model Shop.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<style>
    html, body {
        margin: 0;
        padding: 0;
        background-color: #000000;
        overflow-x: hidden;
    }

    .auth-outer-wrapper {
        background-color: #000000;
        min-height: 100vh;
        display: flex;
        align-items: stretch;
        justify-content: center;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .auth-card {
        background-color: #000000;
        border-radius: 0;
        overflow: hidden;
        width: 100%;
        max-width: 1100px;
        min-height: 100vh;
        box-shadow: none;
        display: flex;
    }

    .auth-banner-side {
        position: relative;
        background: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80') center center no-repeat;
        background-size: cover;
        min-height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 3rem 2.5rem;
    }

    .auth-banner-side::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0.4) 100%);
        z-index: 1;
    }

    .auth-banner-content {
        position: relative;
        z-index: 2;
        color: #ffffff;
    }

    .auth-banner-content h2 {
        font-size: 1.6rem;
        font-weight: 400;
        line-height: 1.4;
        margin-bottom: 0.5rem;
        letter-spacing: -0.5px;
    }

    .auth-banner-content p {
        color: #b0b5a5;
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    .auth-form-side {
        padding: 3rem 3.5rem;
        color: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 100%;
    }

    .auth-form-side h1 {
        font-size: 1.75rem;
        font-weight: 500;
        margin-bottom: 0.75rem;
        letter-spacing: -0.5px;
    }

    .auth-subtitle {
        color: #888888;
        font-size: 0.9rem;
        line-height: 1.5;
        margin-bottom: 2.5rem;
    }

    .auth-form-side .form-label {
        color: #aaaaaa;
        font-size: 0.8rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .auth-form-side .form-control {
        background-color: #141414;
        border: 1px solid #222222;
        color: #ffffff;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 0.9rem;
    }

    .auth-form-side .form-control:focus {
        background-color: #141414;
        border-color: #a3a899;
        box-shadow: none;
        color: #ffffff;
    }

    .auth-form-side .form-control::placeholder {
        color: #444444;
    }

    .btn-login {
        background-color: #b1b8a5;
        color: #1c2017;
        font-weight: 600;
        border: none;
        border-radius: 8px;
        padding: 0.8rem;
        width: 100%;
        font-size: 0.95rem;
        margin-top: 1.5rem;
        transition: background-color 0.2s ease;
    }

    .btn-login:hover {
        background-color: #c2c9b6;
        color: #1c2017;
    }

    .auth-footer-text {
        text-align: center;
        font-size: 0.8rem;
        color: #666666;
        margin-top: 2rem;
    }

    .auth-footer-text a {
        color: #ffffff;
        text-decoration: none;
    }

    .auth-footer-text a:hover {
        text-decoration: underline;
    }

    .form-check-input {
        background-color: #141414;
        border: 1px solid #222222;
    }

    .form-check-input:checked {
        background-color: #b1b8a5;
        border-color: #b1b8a5;
    }

    .text-danger {
        font-size: 0.8rem;
    }
</style>

<div class="auth-outer-wrapper">
    <div class="auth-card">
        <div class="row g-0">
            <div class="col-lg-5 d-none d-lg-flex">
                <div class="auth-banner-side w-100">
                    <div class="auth-banner-content">
                        <h2>Welcome back.<br>Continue your journey with us.</h2>
                        <p>Structura — Your gateway to architectural excellence.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-7 col-12">
                <div class="auth-form-side">
                    <h1>Sign in</h1>
                    <p class="auth-subtitle">Access your account to manage projects, collaborate, and explore premium resources.</p>

                    <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email address *</label>
                            <input asp-for="Email" class="form-control" placeholder="e.g. andrew@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password *</label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="••••••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <label class="form-check-label" style="color: #888888; font-size: 0.85rem;">
                                <input asp-for="RememberMe" class="form-check-input" /> @Html.DisplayNameFor(model => model.RememberMe)
                            </label>
                        </div>

                        <button type="submit" class="btn btn-login">Sign in</button>

                        <div class="auth-footer-text">
                            Don't have an account? <a asp-controller="Account" asp-action="Register">Create one</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
