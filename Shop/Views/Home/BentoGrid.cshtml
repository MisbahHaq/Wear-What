@{
    ViewData["Title"] = "Bento Grid";
}

<div class="bento-container">
    <!-- Navigation Bar -->
    <nav class="bento-nav">
        <div class="nav-content">
            <button class="hamburger-btn" type="button">&#9776;</button>
            <div class="nav-links">
                <a href="#" class="nav-link">HOME</a>
                <a href="#" class="nav-link dropdown-link">COLLECTIONS &#9662;</a>
                <a href="#" class="nav-link">PRODUCTS</a>
                <a href="#" class="nav-link">CONTACT</a>
            </div>
            <div class="search-container">
                <input type="text" placeholder="Search..." class="search-input" />
                <span class="search-icon">&#128269;</span>
            </div>
        </div>
    </nav>

    <!-- Bento Grid -->
    <div class="bento-grid">
        <!-- Top Left Panel -->
        <div class="bento-panel top-left-panel">
            <img src="https://via.placeholder.com/400x400/000000/FFFFFF?text=BOTTLE" alt="Water Bottle" class="panel-image" />
            <div class="panel-text">
                <span class="text-large">AMERICAN TALL</span>
                <span class="text-stacked">WATER<br />BOTTLE</span>
            </div>
            <div class="accent-panel">
                <button class="arrow-btn" type="button">&gt;</button>
            </div>
        </div>

        <!-- Right Long Panel -->
        <div class="bento-panel right-long">
            <div class="vertical-content">
                <img src="https://via.placeholder.com/300x600/000000/FFFFFF?text=GERNA+BW" alt="Water Bottle with Giraffe" class="bottle-image" />
            </div>
        </div>

        <!-- Bottom Left Promo Panel -->
        <div class="bento-panel bottom-left">
            <div class="promo-content">
                <div class="promo-text">
                    <span class="discount">20% OFF</span>
                    <span class="promo-subtitle">on all the products / shop it now</span>
                </div>
                <button class="shop-btn" type="button">
                    <span>SHOP ALL PRODUCTS</span>
                    <span class="cart-icon">&#128722;</span>
                </button>
            </div>
        </div>

        <!-- Bottom Middle Preview Panel -->
        <div class="bento-panel bottom-middle">
            <img src="https://via.placeholder.com/120x120/FFFFFF/000000?text=BLACK" alt="Black T-Shirt" class="tshirt-preview black-tshirt" />
            <img src="https://via.placeholder.com/120x120/FFFFFF/000000?text=WHITE" alt="White T-Shirt" class="tshirt-preview white-tshirt" />
            <span class="preview-text">CHECK OUT THE NEW STUFF</span>
        </div>

        <!-- Interactive Intersecting Button -->
        <button class="intersect-btn" type="button">&#43;</button>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector('.intersect-btn').addEventListener('click', function() {
            alert('Quick View - Add to Cart action triggered!');
        });
        document.querySelector('.shop-btn').addEventListener('click', function() {
            window.location.href = '/Products';
        });
    </script>
}