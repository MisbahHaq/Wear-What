@model IEnumerable<Shop.Models.Banner>

@{
    ViewData["Title"] = "Manage Banners";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Manage Banners</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header fw-bold">Add New Banner</div>
            <div class="card-body">
                <form asp-action="CreateBanner" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Image URL</label>
                        <input name="ImageUrl" class="form-control" placeholder="https://... or /images/..." />
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Title / Alt Text</label>
                        <input name="Title" class="form-control" placeholder="Holiday Special Offers" />
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Link URL (optional)</label>
                        <input name="LinkUrl" class="form-control" placeholder="/Products or https://..." />
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" name="IsActive" type="checkbox" id="IsActive" value="true" checked />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label" for="IsActive">Active (shown on home page)</label>
                    </div>
                    <button type="submit" class="btn btn-primary">Add Banner</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        @if (!Model.Any())
        {
            <div class="alert alert-info">No banners have been added yet.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var banner in Model)
                {
                    <div class="col-12">
                        <div class="card @(banner.IsActive ? "" : "border-secondary opacity-75")">
                            <div class="row g-0 align-items-center">
                                <div class="col-4">
                                    <img src="@banner.ImageUrl" class="img-fluid rounded-start" style="height:110px;width:100%;object-fit:cover;" alt="@banner.Title" />
                                </div>
                                <div class="col-8">
                                    <div class="card-body py-2">
                                        <h6 class="card-title mb-1">@banner.Title</h6>
                                        <small class="text-muted d-block mb-1">@banner.ImageUrl</small>
                                        @if (banner.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                        <a asp-action="EditBanner" asp-route-id="@banner.Id" class="btn btn-sm btn-outline-secondary float-end me-2">Edit</a>
                                        <form asp-action="DeleteBanner" method="post" class="d-inline float-end" asp-antiforgery="true">
                                            <input type="hidden" name="id" value="@banner.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (ViewBag.Categories != null)
{
    var categories = (System.Collections.Generic.IEnumerable<Shop.Models.ShopCategory>)ViewBag.Categories;
    <hr class="my-5" />
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Categories</h2>
        <a asp-controller="Categories" asp-action="Create" class="btn btn-primary">Add Category</a>
    </div>
    <p class="text-muted small mb-3">These appear in the home page bento grid. Edit a category to change its name and image.</p>

    @if (!categories.Any())
    {
        <div class="alert alert-info">No categories have been added yet.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var category in categories)
            {
                <div class="col-md-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(category.ImageUrl))
                        {
                            <img src="@category.ImageUrl" class="card-img-top" style="height:160px;object-fit:cover;" alt="@category.Name" />
                        }
                        else
                        {
                            <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height:160px;">@(category.Name.Length > 0 ? category.Name[0].ToString().ToUpper() : "?")</div>
                        }
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <span class="fw-bold">@category.Name</span>
                            <a asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
