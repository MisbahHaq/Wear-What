@model Shop.Models.ShopItem

@{
    ViewData["Title"] = Model.Name;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<h1>@Model.Name</h1>

<p>@Model.Description</p>

@if (Model.OwnerId == currentUserId)
{
    <p>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
        <a asp-controller="Products" asp-action="Create" class="btn btn-primary">Add Product</a>
    </p>
}
else if (currentUserId != null)
{
    <form asp-controller="ShopFollow" asp-action="Follow" method="post" class="d-inline">
        <input type="hidden" name="shopId" value="@Model.Id" />
        <button type="submit" class="btn btn-outline-primary">Follow Shop</button>
    </form>
}

@if (Model.Products?.Any() == true)
{
    <h3>Products</h3>
    <div class="row">
        @foreach (var product in Model.Products!)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text">@product.Description</p>
                        <p class="card-text"><strong>$@product.Price.ToString("0.00")</strong></p>
                        @if (Model.OwnerId == currentUserId)
                        {
                            <a asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-controller="Products" asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No products in this shop yet.</p>
}