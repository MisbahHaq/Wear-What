@model IEnumerable<Product>
@{
    ViewData["Title"] = "My Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>My Products</h2>
    <a asp-action="Create" class="btn btn-success mb-3">+ Add Product</a>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No products found. Create a shop first, then add products.</div>
    }
    else
    {
        <div class="row">
            @foreach (var product in Model)
            {
                var image = product.Images.OrderBy(i => i.Id).FirstOrDefault()?.Url;
                <div class="col-md-4 mb-3">
                    <div class="card shadow h-100">
                        @if (!string.IsNullOrEmpty(image))
                        {
                            <img src="@image" class="card-img-top" alt="@product.Name" style="height:200px; object-fit:cover;" />
                        }
                        <div class="card-body">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text text-muted small">Shop: @product.Shop?.Name</p>
                            <p class="card-text">@product.Description</p>
                            <h6 class="text-success">$@product.Price.ToString("F2")</h6>
                            <span class="badge bg-secondary">Stock: @product.Stock</span>
                            <span class="badge bg-info text-dark">Broad: @product.BroadCategory</span>
                            @if (product.Category != null)
                            {
                                <span class="badge bg-primary">Category: @product.Category.Name</span>
                            }
                        </div>
                        <div class="card-footer d-flex justify-content-between">
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
