@model IEnumerable<Shop>
@model IEnumerable<Shop>
@{
    ViewData["Title"] = "My Shops";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>My Shops</h2>
    <a asp-action="Create" class="btn btn-success mb-3">+ Add Shop</a>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No shops found. Click the button above to create your first shop.</div>
    }
    else
    {
        <div class="row">
            @foreach (var shop in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow h-100">
                        <div class="card-body">
                            <h5 class="card-title">@shop.Name</h5>
                            <p class="card-text text-muted small">@shop.Location</p>
                            <p class="card-text">@shop.Description</p>
                            <small class="text-muted">Created: @shop.CreatedAt.ToString("yyyy-MM-dd")</small>
                        </div>
                        <div class="card-footer d-flex justify-content-between">
                            <a asp-action="Edit" asp-route-id="@shop.Id" class="btn btn-sm btn-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@shop.Id" class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
