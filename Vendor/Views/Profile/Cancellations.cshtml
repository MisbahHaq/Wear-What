@model List<Cancellation>
@{
    ViewData["Title"] = "My Cancellations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>My Cancellations</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No cancellations found.</div>
    }
    else
    {
        <div class="accordion" id="cancellationsAccordion">
            @for (int i = 0; i < Model.Count; i++)
            {
                var cancellation = Model[i];
                <div class="accordion-item">
                    <h3 class="accordion-header" id="heading-c-@cancellation.Id">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-c-@cancellation.Id">
                            <span class="me-3">Order #@cancellation.OrderId</span>
                            <span class="badge bg-@(cancellation.Status == "Approved" ? "success" : cancellation.Status == "Rejected" ? "danger" : "warning")">@cancellation.Status</span>
                            <span class="ms-auto">@cancellation.RequestedAt.ToString("yyyy-MM-dd")</span>
                        </button>
                    </h3>
                    <div id="collapse-c-@cancellation.Id" class="accordion-collapse collapse" data-bs-parent="#cancellationsAccordion">
                        <div class="accordion-body">
                            <p><strong>Reason:</strong> @cancellation.Reason</p>
                            <p><strong>Requested At:</strong> @cancellation.RequestedAt.ToString("yyyy-MM-dd HH:mm")</p>
                            @if (cancellation.ProcessedAt.HasValue)
                            {
                                <p><strong>Processed At:</strong> @cancellation.ProcessedAt.Value.ToString("yyyy-MM-dd HH:mm")</p>
                            }
                            <h6>Items</h6>
                            @foreach (var item in cancellation.Order.Items)
                            {
                                <div class="d-flex align-items-center border-bottom pb-2 mb-2">
                                    @if (!string.IsNullOrEmpty(item.ProductImage))
                                    {
                                        <img src="@item.ProductImage" class="rounded me-3" style="width:60px;height:60px;object-fit:cover;" />
                                    }
                                    <div>
                                        <h6 class="mb-0">@item.ProductName</h6>
                                        <small class="text-muted">Qty: @item.Quantity × $@item.UnitPrice.ToString("F2")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
