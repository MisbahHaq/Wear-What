<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MultiVendor Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #000000;
            color: #e0e0e0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-brand, .nav-link {
            color: #ffffff !important;
        }
        .nav-link:hover {
            color: #b1b8a5 !important;
        }
        main {
            flex: 1;
            padding-top: 2rem;
            padding-bottom: 3rem;
        }
        footer {
            border-top: 1px solid #222;
            color: #888;
            padding: 1.5rem 0;
        }
        h1, h2, h3, h4, h5, h6 {
            color: #ffffff;
        }
        .card {
            background-color: #141414;
            border: 1px solid #222;
            color: #e0e0e0;
        }
        .card-title {
            color: #ffffff;
        }
        table {
            color: #e0e0e0;
        }
        table thead th {
            border-color: #333;
            color: #b1b8a5;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        table tbody td {
            border-color: #222;
        }
        .table > :not(caption) > * > * {
            background-color: transparent;
        }
        .form-control {
            background-color: #141414;
            border: 1px solid #222;
            color: #ffffff;
        }
        .form-control:focus {
            background-color: #141414;
            border-color: #a3a899;
            box-shadow: none;
            color: #ffffff;
        }
        .form-control::placeholder {
            color: #444444;
        }
        .form-label {
            color: #aaaaaa;
            font-size: 0.85rem;
            font-weight: 500;
        }
        .alert {
            background-color: #141414;
            border: 1px solid #222;
            color: #e0e0e0;
        }
        .btn-dark {
            background-color: #333;
            border-color: #333;
            color: #fff;
        }
        .btn-dark:hover {
            background-color: #444;
            border-color: #444;
        }
        .btn-outline-dark {
            border-color: #444;
            color: #e0e0e0;
        }
        .btn-outline-dark:hover {
            background-color: #222;
            border-color: #555;
            color: #fff;
        }
        .btn-outline-secondary {
            border-color: #444;
            color: #e0e0e0;
        }
        .btn-outline-secondary:hover {
            background-color: #222;
            border-color: #555;
            color: #fff;
        }
        .badge {
            font-weight: 500;
        }
        a {
            color: #b1b8a5;
        }
        a:hover {
            color: #c2c9b6;
        }
        section.section {
            margin-bottom: 3rem;
        }
        .section-title {
            font-size: 1.5rem;
            font-weight: 500;
            color: #ffffff;
            margin-bottom: 1.5rem;
            letter-spacing: -0.3px;
        }
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 1.25rem;
        }
        .product-card {
            background-color: #141414;
            border: 1px solid #222;
            border-radius: 12px;
            overflow: hidden;
            transition: transform 0.2s ease, border-color 0.2s ease;
            text-decoration: none;
            color: inherit;
        }
        .product-card:hover {
            transform: translateY(-2px);
            border-color: #333;
            color: inherit;
        }
        .product-card-image {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }
        .product-card-image-placeholder {
            width: 100%;
            height: 180px;
            background: linear-gradient(135deg, #1a1a1a, #2a2a2a);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: 600;
            color: #555;
        }
        .product-card-body {
            padding: 1rem 1.25rem 1.25rem;
        }
        .product-card-title {
            font-weight: 600;
            font-size: 0.95rem;
            color: #fff;
            margin-bottom: 0.35rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .product-card-description {
            font-size: 0.85rem;
            color: #888;
            margin-bottom: 0.5rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .product-card-price {
            font-weight: 700;
            font-size: 1.05rem;
            color: #b1b8a5;
        }
        .product-card-shop {
            font-size: 0.8rem;
            color: #666;
            margin-top: 0.25rem;
        }
        .product-card-btn {
            margin-top: 0.75rem;
            border-radius: 8px;
            font-size: 0.8rem;
            padding: 0.35rem 0.9rem;
        }
        .hero {
            display: flex;
            background: #000;
            border-radius: 16px;
            overflow: hidden;
            min-height: 320px;
            margin-bottom: 3rem;
            border: 1px solid #222;
        }
        .hero-left {
            flex: 1;
            padding: 3rem 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .hero-eyebrow {
            color: #b1b8a5;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.75rem;
        }
        .hero-title {
            font-size: 2.25rem;
            font-weight: 500;
            color: #fff;
            margin-bottom: 1rem;
            line-height: 1.2;
        }
        .hero-sub {
            color: #888;
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 1.75rem;
        }
        .hero-cta {
            display: inline-block;
            background: #b1b8a5;
            color: #1c2017;
            font-weight: 600;
            padding: 0.75rem 1.75rem;
            border-radius: 8px;
            text-decoration: none;
            width: fit-content;
        }
        .hero-cta:hover {
            background: #c2c9b6;
            color: #1c2017;
        }
        .hero-right {
            flex: 1;
            position: relative;
        }
        .hero-right img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .hero-media-placeholder {
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #111, #222);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #555;
            font-size: 1.25rem;
        }
        .bento {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 3rem;
        }
        .bento-stack {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .bento-card {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            text-decoration: none;
            color: #fff;
            display: block;
            min-height: 180px;
        }
        .bento-large {
            min-height: 100%;
        }
        .bento-large img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: absolute;
            inset: 0;
        }
        .bento-label {
            position: absolute;
            bottom: 1rem;
            left: 1.25rem;
            font-weight: 600;
            font-size: 1.1rem;
            z-index: 2;
            text-shadow: 0 2px 8px rgba(0,0,0,0.7);
        }
        .bento-small {
            min-height: 140px;
        }
        .bento-small img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: absolute;
            inset: 0;
        }
        .bento-wide {
            min-height: 140px;
        }
        .bento-wide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: absolute;
            inset: 0;
        }
        .bento-all {
            background: #141414;
            border: 2px dashed #333;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .bento-label-br {
            position: absolute;
            white-space: nowrap;
        }
        .filter-tabs {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-bottom: 1.5rem;
        }
        .tab {
            background: #141414;
            border: 1px solid #222;
            color: #888;
            padding: 0.5rem 1.25rem;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }
        .tab:hover {
            border-color: #444;
            color: #fff;
        }
        .tab.active {
            background: #222;
            border-color: #444;
            color: #fff;
        }
        .features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.5rem;
            margin: 3rem 0;
        }
        .feature {
            background: #0a0a0a;
            border: 1px solid #222;
            border-radius: 16px;
            padding: 2rem;
            text-align: center;
        }
        .feature svg {
            color: #b1b8a5;
            margin-bottom: 1rem;
        }
        .feature-title {
            font-weight: 600;
            color: #fff;
            margin-bottom: 0.5rem;
        }
        .feature-text {
            font-size: 0.9rem;
            color: #888;
            line-height: 1.5;
        }
        .cta-banner {
            display: flex;
            background: #0a0a0a;
            border: 1px solid #222;
            border-radius: 16px;
            overflow: hidden;
            min-height: 220px;
            margin: 3rem 0;
        }
        .cta-left {
            flex: 1;
            padding: 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .cta-title {
            font-size: 1.5rem;
            font-weight: 500;
            color: #fff;
            margin-bottom: 0.75rem;
        }
        .cta-sub {
            color: #888;
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }
        .cta-pill {
            display: inline-block;
            border: 1px solid #444;
            color: #e0e0e0;
            padding: 0.6rem 1.5rem;
            border-radius: 8px;
            text-decoration: none;
            width: fit-content;
            font-size: 0.9rem;
        }
        .cta-pill:hover {
            background: #222;
            border-color: #555;
            color: #fff;
        }
        .cta-right {
            flex: 0 0 320px;
        }
        .cta-right img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .text-danger {
            color: #dc3545 !important;
        }
        .alert-info {
            background-color: #1a2332;
            border-color: #2a3a52;
            color: #a3c4d9;
        }
        .alert-warning {
            background-color: #2a2214;
            border-color: #4a3a22;
            color: #d9c4a3;
        }
        .alert-success {
            background-color: #14261a;
            border-color: #224a2e;
            color: #a3d4b5;
        }
        .list-group-item {
            background-color: #141414;
            border-color: #222;
            color: #e0e0e0;
        }
        .list-group-item:hover {
            background-color: #1a1a1a;
            color: #fff;
        }
    </style>
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MultiVendor Admin</a>
                <div class="d-flex align-items-center gap-3">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <a class="nav-link" asp-controller="Admin" asp-action="Index">Dashboard</a>
                        <a class="nav-link" asp-controller="Admin" asp-action="Products">Products</a>
                        <a class="nav-link" asp-controller="Admin" asp-action="Shops">Shops</a>
                        <a class="nav-link" asp-controller="Categories" asp-action="Index">Categories</a>
                        <a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a>
                    }
                    else
                    {
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Sign In</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container" style="max-width: 1400px;">
        <main role="main" class="py-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer-section mt-auto">
        <div class="container">
            <span>&copy; 2026 - MultiVendor Admin. All rights reserved.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
