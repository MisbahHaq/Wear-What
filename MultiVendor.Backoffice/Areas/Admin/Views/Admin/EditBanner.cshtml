@model MultiVendor.Core.Models.Banner

@{
    ViewData["Title"] = "Edit Banner";
}

<section class="section">
    <h1 class="section-title">@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <form asp-action="EditBanner" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Image URL</label>
                            <input name="ImageUrl" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Title</label>
                            <input name="Title" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Link URL</label>
                            <input name="LinkUrl" class="form-control" />
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" name="IsActive" type="checkbox" value="true" @(Model.IsActive ? "checked" : "") />
                            <input type="hidden" name="IsActive" value="false" />
                            <label class="form-check-label">Active</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-dark">Save</button>
                            <a asp-action="Banners" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
