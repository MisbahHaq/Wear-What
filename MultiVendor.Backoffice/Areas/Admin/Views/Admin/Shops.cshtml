@model IEnumerable<MultiVendor.Core.Models.ShopItem>?

@{
    ViewData["Title"] = "Manage Shops";
    var status = ViewBag.Status as string;
}

<section class="section">
    <h1 class="section-title">@ViewData["Title"]</h1>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-dark">@TempData["StatusMessage"]</div>
    }

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Shop</th>
                            <th>Owner</th>
                            <th>Status</th>
                            <th>Suspended</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var s in Model)
                            {
                                <tr>
                                    <td>@s.Name</td>
                                    <td>@s.OwnerId</td>
                                    <td><span class="badge bg-@(s.Status == "Approved" ? "success" : "warning")">@s.Status</span></td>
                                    <td>@(s.IsSuspended ? "Yes" : "No")</td>
                                    <td>
                                        @if (!s.IsSuspended)
                                        {
                                            <form asp-action="SuspendShop" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Suspend this shop?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-warning">Suspend</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="UnsuspendShop" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Unsuspend this shop?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success">Unsuspend</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4" style="color:#888;">No shops found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
