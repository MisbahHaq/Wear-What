@model IEnumerable<MultiVendor.Core.Models.Product>?

@{
    ViewData["Title"] = "Manage Products";
    var status = ViewBag.Status as string;
}

<section class="section">
    <h1 class="section-title">@ViewData["Title"]</h1>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-dark">@TempData["StatusMessage"]</div>
    }

    <div class="card mb-3" style="border:none; background:transparent;">
        <div class="card-body py-2">
            <div class="d-flex gap-2">
                <a asp-action="Products" class="btn btn-outline-secondary btn-sm">All</a>
                <a asp-action="Products" asp-route-status="Pending" class="btn btn-outline-secondary btn-sm">Pending</a>
                <a asp-action="Products" asp-route-status="Approved" class="btn btn-outline-secondary btn-sm">Approved</a>
                <a asp-action="Products" asp-route-status="Rejected" class="btn btn-outline-secondary btn-sm">Rejected</a>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Shop</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td>@p.Name</td>
                                    <td>@p.Shop?.Name</td>
                                    <td>$@p.Price.ToString("0.00")</td>
                                    <td>
                                        <span class="badge bg-@(p.ModerationStatus == "Approved" ? "success" : p.ModerationStatus == "Rejected" ? "danger" : "warning")">@p.ModerationStatus</span>
                                        @if (!string.IsNullOrEmpty(p.RejectionReason))
                                        {
                                            <div class="text-muted small" style="color:#888 !important;">@p.RejectionReason</div>
                                        }
                                    </td>
                                    <td>
                                        @if (p.ModerationStatus != "Approved")
                                        {
                                            <form asp-action="ApproveProduct" asp-route-id="@p.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                                            </form>
                                        }
                                        @if (p.ModerationStatus != "Rejected")
                                        {
                                            <form asp-action="RejectProduct" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="var r=prompt('Rejection reason (optional):'); if(r===null) return false; document.getElementById('rej-reason-@p.Id').value=r;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="reason" id="rej-reason-@p.Id" value="" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4" style="color:#888;">No products found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
