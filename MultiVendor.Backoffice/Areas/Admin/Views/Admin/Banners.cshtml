@model IEnumerable<MultiVendor.Core.Models.Banner>?

@{
    ViewData["Title"] = "Manage Banners";
}

<section class="section">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0" style="font-size:1.75rem; font-weight:500;">Manage Banners</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <form asp-action="CreateBanner" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Image URL</label>
                            <input name="ImageUrl" class="form-control" placeholder="https://... or /images/..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Title / Alt Text</label>
                            <input name="Title" class="form-control" placeholder="Holiday Special Offers" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Link URL (optional)</label>
                            <input name="LinkUrl" class="form-control" placeholder="/Products or https://..." />
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" name="IsActive" type="checkbox" id="IsActive" value="true" checked />
                            <input type="hidden" name="IsActive" value="false" />
                            <label class="form-check-label" for="IsActive">Active (shown on home page)</label>
                        </div>
                        <button type="submit" class="btn btn-dark">Add Banner</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">No banners have been added yet.</div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var banner in Model)
                    {
                        <div class="col-12">
                            <div class="card @(banner.IsActive ? "" : "border-secondary")" style="@(banner.IsActive ? "" : "opacity:0.6;")">
                                <div class="row g-0 align-items-center">
                                    <div class="col-4">
                                        <img src="@banner.ImageUrl" class="img-fluid rounded-start" style="height:110px;width:100%;object-fit:cover;" alt="@banner.Title" />
                                    </div>
                                    <div class="col-8">
                                        <div class="card-body py-2">
                                            <h6 class="card-title mb-1">@banner.Title</h6>
                                            <p class="card-text small mb-1" style="color:#888;">@banner.LinkUrl</p>
                                            <span class="badge bg-@(banner.IsActive ? "success" : "secondary")">@(banner.IsActive ? "Active" : "Inactive")</span>
                                            <div class="mt-2">
                                                <a asp-action="EditBanner" asp-route-id="@banner.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                                <form asp-action="DeleteBanner" asp-route-id="@banner.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this banner?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>
