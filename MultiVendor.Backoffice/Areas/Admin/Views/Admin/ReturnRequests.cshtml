@model IEnumerable<MultiVendor.Core.Models.ReturnRequest>?

@{
    ViewData["Title"] = "Return Requests";
}

<section class="section">
    <h1 class="section-title">@ViewData["Title"]</h1>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-dark">@TempData["StatusMessage"]</div>
    }

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Buyer</th>
                            <th>Seller</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th>Refund</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td>#@r.OrderItemId</td>
                                    <td>@(r.Buyer?.FullName ?? r.Buyer?.UserName ?? "-")</td>
                                    <td>@(r.Seller?.FullName ?? "-")</td>
                                    <td>@r.Reason</td>
                                    <td><span class="badge bg-@(r.Status == "Pending" ? "warning" : r.Status == "Approved" ? "success" : "danger")">@r.Status</span></td>
                                    <td>@r.RefundStatus</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4" style="color:#888;">No return requests found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
