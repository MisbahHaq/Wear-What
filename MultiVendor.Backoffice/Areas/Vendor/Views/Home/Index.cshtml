@model IEnumerable<MultiVendor.Core.Models.Product>?

@{
    ViewData["Title"] = "Home Page";

    var banners = (ViewBag.Banners as System.Collections.Generic.IEnumerable<MultiVendor.Core.Models.Banner>)
        ?? System.Linq.Enumerable.Empty<MultiVendor.Core.Models.Banner>();
    var categories = (ViewBag.Categories as System.Collections.Generic.IEnumerable<MultiVendor.Core.Models.ShopCategory>)
        ?? System.Linq.Enumerable.Empty<MultiVendor.Core.Models.ShopCategory>();
    var catList = categories.ToList();

    var heroBanner = banners.FirstOrDefault();
    var firstCatName = catList.FirstOrDefault()?.Name ?? "All";
}

@* ===== HERO BANNER SECTION ===== *@
<section class="hero">
    <div class="hero-left">
        <span class="hero-eyebrow">Limited time offer</span>
        <h1 class="hero-title">30% discount on your first purchase</h1>
        <p class="hero-sub">Sign up today and save big on your favorite products across every category.</p>
        <a class="btn hero-cta" asp-controller="Products" asp-action="Index">Shop now</a>
    </div>
    <div class="hero-right">
        @if (heroBanner != null)
        {
            if (!string.IsNullOrEmpty(heroBanner.LinkUrl))
            {
                <a href="@heroBanner.LinkUrl" class="hero-media">
                    <img src="@heroBanner.ImageUrl" alt="@heroBanner.Title" />
                </a>
            }
            else
            {
                <div class="hero-media">
                    <img src="@heroBanner.ImageUrl" alt="@heroBanner.Title" />
                </div>
            }
        }
        else
        {
            <div class="hero-media hero-media-placeholder">Holiday Offers</div>
        }
    </div>
</section>

@* ===== GRID CATEGORIES (BENTO) ===== *@
@if (catList.Any())
{
    <section class="section">
        <h2 class="section-title">Shop by category</h2>
        <div class="bento">
            @* Large left card *@
            <a class="bento-card bento-large" asp-controller="Products" asp-action="Index" asp-route-categoryId="@catList[0].Id">
                <img src="@(catList[0].ImageUrl ?? "/images/placeholder.png")" alt="@catList[0].Name" />
                <span class="bento-label">@catList[0].Name</span>
            </a>

            <div class="bento-stack">
                @if (catList.Count > 1)
                {
                    <a class="bento-card bento-small" asp-controller="Products" asp-action="Index">
                        <img src="@(catList[1].ImageUrl ?? "/images/placeholder.png")" alt="@catList[1].Name" />
                        <span class="bento-label">@catList[1].Name</span>
                    </a>
                }
                @if (catList.Count > 2)
                {
                    <a class="bento-card bento-small" asp-controller="Products" asp-action="Index">
                        <img src="@(catList[2].ImageUrl ?? "/images/placeholder.png")" alt="@catList[2].Name" />
                        <span class="bento-label">@catList[2].Name</span>
                    </a>
                }
                @if (catList.Count > 3)
                {
                    <a class="bento-card bento-wide" asp-controller="Products" asp-action="Index">
                        <img src="@(catList[3].ImageUrl ?? "/images/placeholder.png")" alt="@catList[3].Name" />
                        <span class="bento-label bento-label-br">@catList[3].Name</span>
                    </a>
                }
                else
                {
                    <a class="bento-card bento-wide bento-all" asp-controller="Products" asp-action="Index">
                        <span class="bento-label bento-label-br">View all categories</span>
                    </a>
                }
            </div>
        </div>
    </section>
}

@* ===== PRODUCT SHOWCASE / TABBED SLIDER ===== *@
<section class="section">
    <h2 class="section-title">Best of this week</h2>

    <div class="filter-tabs" id="filterTabs">
        <button type="button" class="tab" data-filter="all">All</button>
        @foreach (var cat in catList)
        {
            <button type="button" class="tab @(cat.Name == firstCatName ? "active" : "")" data-filter="@cat.Name">@cat.Name</button>
        }
    </div>

    @{
        var bestSellers = (ViewBag.BestSellers as System.Collections.Generic.IEnumerable<MultiVendor.Core.Models.Product>)
            ?? System.Linq.Enumerable.Empty<MultiVendor.Core.Models.Product>();
    }

    @if (!bestSellers.Any())
    {
        <div class="alert alert-info">No products available yet.</div>
    }
    else
    {
        <div class="product-grid" id="productGrid">
            @foreach (var item in bestSellers)
            {
                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id"
                   class="product-card text-decoration-none" data-category="@item.Category?.Name">
                    @if (!string.IsNullOrEmpty(item.ImageUrl1))
                    {
                        <img src="@item.ImageUrl1" class="product-card-image" alt="@item.Name" />
                    }
                    else
                    {
                         <div class="product-card-image-placeholder">@(!string.IsNullOrEmpty(item.Name) ? item.Name[0].ToString().ToUpper() : "?")</div>
                    }
                    <div class="product-card-body">
                        <div class="product-card-title">@item.Name</div>
                        <div class="product-card-description">@item.Description</div>
                        <div class="product-card-price">$@item.Price.ToString("0.00")</div>
                        <div class="product-card-shop">@item.Shop?.Name</div>
                        <span class="btn btn-outline-primary btn-sm product-card-btn">Details</span>
                    </div>
                </a>
            }
        </div>
    }
</section>

@* ===== MIDDLE PROMOTION / CTA BANNER ===== *@
<section class="cta-banner">
    <div class="cta-left">
        <h2 class="cta-title">Need specialist help?</h2>
        <p class="cta-sub">Our team is here to guide you to the perfect choices for your home and lifestyle.</p>
        <a class="cta-pill" asp-controller="Home" asp-action="Privacy">our mission</a>
    </div>
    <div class="cta-right">
        <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?auto=format&fit=crop&w=900&q=80" alt="Kitchen" />
    </div>
</section>

@* ===== VALUE PROPOSITIONS / FEATURES ===== *@
<section class="features">
    <div class="feature">
        <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
            <path d="M3 6h18"></path>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <h3 class="feature-title">Bonus system</h3>
        <p class="feature-text">Earn rewards on every order and unlock exclusive member-only deals.</p>
    </div>
    <div class="feature">
        <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <path d="M16 8h4l3 3v5h-7Z"></path>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
        <h3 class="feature-title">Free delivery</h3>
        <p class="feature-text">Enjoy free shipping on all orders, straight to your doorstep.</p>
    </div>
    <div class="feature">
        <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <h3 class="feature-title">Always with care</h3>
        <p class="feature-text">Every item is handled and packaged with the utmost attention.</p>
    </div>
</section>

@{
    var officeFurnitureProducts = (ViewBag.OfficeFurnitureProducts as System.Collections.Generic.IEnumerable<MultiVendor.Core.Models.Product>)
        ?? System.Linq.Enumerable.Empty<MultiVendor.Core.Models.Product>();
    var officeFurnitureCategoryId = ViewBag.OfficeFurnitureCategoryId as int?;
    var booksProducts = (ViewBag.BooksProducts as System.Collections.Generic.IEnumerable<MultiVendor.Core.Models.Product>)
        ?? System.Linq.Enumerable.Empty<MultiVendor.Core.Models.Product>();
    var booksCategoryId = ViewBag.BooksCategoryId as int?;
}

@if (officeFurnitureProducts.Any())
{
    <section class="section">
        <h2 class="section-title">Upgrade your office furniture</h2>
        <div class="product-grid">
            @foreach (var item in officeFurnitureProducts)
            {
                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id"
                   class="product-card text-decoration-none" data-category="@item.Category?.Name">
                    @if (!string.IsNullOrEmpty(item.ImageUrl1))
                    {
                        <img src="@item.ImageUrl1" class="product-card-image" alt="@item.Name" />
                    }
                    else
                    {
                         <div class="product-card-image-placeholder">@(!string.IsNullOrEmpty(item.Name) ? item.Name[0].ToString().ToUpper() : "?")</div>
                    }
                    <div class="product-card-body">
                        <div class="product-card-title">@item.Name</div>
                        <div class="product-card-description">@item.Description</div>
                        <div class="product-card-price">$@item.Price.ToString("0.00")</div>
                        <div class="product-card-shop">@item.Shop?.Name</div>
                        <span class="btn btn-outline-primary btn-sm product-card-btn">Details</span>
                    </div>
                </a>
            }
        </div>
        @if (officeFurnitureCategoryId.HasValue)
        {
            <div class="text-center">
                <a class="btn btn-outline-secondary" asp-controller="Products" asp-action="Index" asp-route-categoryId="@officeFurnitureCategoryId.Value">View all</a>
            </div>
        }
    </section>
}

@if (booksProducts.Any())
{
    <section class="section">
        <h2 class="section-title">Books you can't put down</h2>
        <div class="product-grid">
            @foreach (var item in booksProducts)
            {
                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id"
                   class="product-card text-decoration-none" data-category="@item.Category?.Name">
                    @if (!string.IsNullOrEmpty(item.ImageUrl1))
                    {
                        <img src="@item.ImageUrl1" class="product-card-image" alt="@item.Name" />
                    }
                    else
                    {
                         <div class="product-card-image-placeholder">@(!string.IsNullOrEmpty(item.Name) ? item.Name[0].ToString().ToUpper() : "?")</div>
                    }
                    <div class="product-card-body">
                        <div class="product-card-title">@item.Name</div>
                        <div class="product-card-description">@item.Description</div>
                        <div class="product-card-price">$@item.Price.ToString("0.00")</div>
                        <div class="product-card-shop">@item.Shop?.Name</div>
                        <span class="btn btn-outline-primary btn-sm product-card-btn">Details</span>
                    </div>
                </a>
            }
        </div>
        @if (booksCategoryId.HasValue)
        {
            <div class="text-center">
                <a class="btn btn-outline-secondary" asp-controller="Products" asp-action="Index" asp-route-categoryId="@booksCategoryId.Value">View all</a>
            </div>
        }
    </section>
}

@* ===== MORE PRODUCTS ===== *@
@if (Model != null && Model.Any())
{
    <section class="section">
        <h2 class="section-title">More products</h2>
        <div class="product-grid" id="moreProductsGrid">
            @foreach (var item in Model)
            {
                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id"
                   class="product-card text-decoration-none" data-category="@item.Category?.Name">
                    @if (!string.IsNullOrEmpty(item.ImageUrl1))
                    {
                        <img src="@item.ImageUrl1" class="product-card-image" alt="@item.Name" />
                    }
                    else
                    {
                         <div class="product-card-image-placeholder">@(!string.IsNullOrEmpty(item.Name) ? item.Name[0].ToString().ToUpper() : "?")</div>
                    }
                    <div class="product-card-body">
                        <div class="product-card-title">@item.Name</div>
                        <div class="product-card-description">@item.Description</div>
                        <div class="product-card-price">$@item.Price.ToString("0.00")</div>
                        <div class="product-card-shop">@item.Shop?.Name</div>
                        <span class="btn btn-outline-primary btn-sm product-card-btn">Details</span>
                    </div>
                </a>
            }
        </div>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var tabs = document.querySelectorAll('#filterTabs .tab');
            var cards = document.querySelectorAll('#productGrid .product-card');
            tabs.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    tabs.forEach(function (t) { t.classList.remove('active'); });
                    btn.classList.add('active');
                    var filter = btn.getAttribute('data-filter');
                    cards.forEach(function (card) {
                        var cat = card.getAttribute('data-category') || '';
                        card.style.display = (filter === 'all' || cat === filter) ? '' : 'none';
                    });
                });
            });
        })();
    </script>
}


