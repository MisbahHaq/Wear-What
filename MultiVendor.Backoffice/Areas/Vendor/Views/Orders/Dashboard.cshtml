@model OwnerDashboardViewModel

@{
    ViewData["Title"] = "Owner Dashboard";
    var ordersByOrder = (Model.OrderItems != null)
        ? Model.OrderItems.GroupBy(i => i.OrderId).OrderByDescending(g => g.First().Order!.CreatedAt)
        : Enumerable.Empty<IGrouping<int, OrderItem>>();
}

<section class="section">
    <h1 class="section-title">@ViewData["Title"]</h1>

    @if (TempData["OrderMessage"] != null)
    {
        <div class="alert alert-dark">@TempData["OrderMessage"]</div>
    }

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-dark">@TempData["StatusMessage"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Shops</h5>
                    <p class="display-6">@(Model.Shops?.Count ?? 0)</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Orders</h5>
                    <p class="display-6">@ordersByOrder.Count()</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Total Sales</h5>
                    <p class="display-6">$@((Model.TotalSales).ToString("0.00"))</p>
                </div>
            </div>
        </div>
    </div>

    @if (ViewBag.LowStockProducts != null && ((IEnumerable<MultiVendor.Core.Models.Product>)ViewBag.LowStockProducts).Any())
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center">
            <span><strong>Low stock alert:</strong> You have @((ViewBag.LowStockProducts as IEnumerable<Product>)!.Count(p => p.StockQuantity == 0)) out-of-stock and @((ViewBag.LowStockProducts as IEnumerable<Product>)!.Count(p => p.StockQuantity > 0)) low-stock products.</span>
            <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-light">View Products</a>
        </div>
    }

    <h2 class="fw-bold mb-3">Your Shops</h2>
    @if (Model.Shops != null && Model.Shops.Any())
    {
        <div class="list-group mb-4">
            @foreach (var shop in Model.Shops)
            {
                <a asp-controller="Shops" asp-action="Details" asp-route-id="@shop.Id" class="list-group-item list-group-item-action" style="background:#141414; border-color:#222; color:#e0e0e0;">
                    <h5 class="mb-1">@shop.Name</h5>
                    <p class="mb-1" style="color:#888;">@shop.Description</p>
                </a>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info mb-4">
            You do not have a shop yet. <a asp-controller="Shops" asp-action="Create">Create a shop</a> to start receiving orders.
        </div>
    }

    <a asp-action="Analytics" class="btn btn-outline-secondary mb-4">View Sales Analytics</a>

    <h2 class="fw-bold mb-3">Orders</h2>
    @if (ordersByOrder.Any())
    {
        @foreach (var group in ordersByOrder)
        {
            var order = group.First().Order!;
            var orderTotal = group.Sum(i => i.UnitPrice * i.Quantity);

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Order #@group.Key</strong>
                        <span style="color:#888;"> - @order.CreatedAt.ToString("g")</span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <form asp-action="UpdateOrderStatus" method="post" class="d-inline">
                            <input type="hidden" name="orderItemId" value="@group.First().Id" />
                            <select name="status" class="form-select status-select" onchange="this.form.submit()" style="background:var(--bg); color:var(--text); border:1px solid #333;">
                                @foreach (var s in new[] { "Placed", "Confirmed", "Processing", "Shipped", "OutForDelivery", "Delivered", "Cancelled", "ReturnRequested", "Returned" })
                                {
                                    <option value="@s" selected="@(order.Status == s ? "selected" : null)">@s</option>
                                }
                            </select>
                            @Html.AntiForgeryToken()
                        </form>
                        <span class="badge bg-dark">$@orderTotal.ToString("0.00")</span>
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>Customer:</strong> @(order.Customer?.FullName ?? order.Customer?.UserName ?? order.CustomerId)</p>
                    <p class="mb-3"><strong>Shipping Address:</strong> @order.ShippingAddress</p>
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Shop</th>
                                    <th>Quantity</th>
                                    <th>Unit Price</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group)
                                {
                                    <tr>
                                        <td>@item.Product?.Name</td>
                                        <td>@item.Product?.Shop?.Name</td>
                                        <td>@item.Quantity</td>
                                        <td>$@item.UnitPrice.ToString("0.00")</td>
                                        <td>$@((item.UnitPrice * item.Quantity).ToString("0.00"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">No orders yet.</div>
    }
</section>
