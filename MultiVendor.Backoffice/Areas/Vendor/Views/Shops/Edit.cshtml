@model MultiVendor.Core.Models.ShopItem

@{
    ViewData["Title"] = "Edit Shop";
}

<section class="section">
    <h1 class="section-title">@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ProfileBannerUrl" class="form-label"></label>
                            <input asp-for="ProfileBannerUrl" class="form-control" />
                            <span asp-validation-for="ProfileBannerUrl" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ProfileImageUrl" class="form-label"></label>
                            <input asp-for="ProfileImageUrl" class="form-control" />
                            <span asp-validation-for="ProfileImageUrl" class="text-danger"></span>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-dark">Save</button>
                            <a asp-controller="Orders" asp-action="Dashboard" class="btn btn-outline-secondary">Back</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
