@model MultiVendor.Core.Models.ShopItem

@{
    ViewData["Title"] = "Delete Shop";
}

<section class="section">
    <h1 class="section-title">@ViewData["Title"]</h1>

    <div class="alert alert-warning">
        <h4>Are you sure you want to delete this shop?</h4>
        <p class="mb-1"><strong>@Model.Name</strong></p>
        <p class="mb-0">@Model.Description</p>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-outline-danger">Delete</button>
        <a asp-controller="Orders" asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
    </form>
</section>
