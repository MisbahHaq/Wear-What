@model MultiVendor.Core.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<section class="section">
    <h1 class="section-title">@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label"></label>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="StockQuantity" class="form-label"></label>
                                <input asp-for="StockQuantity" class="form-control" type="number" min="0" step="1" />
                                <span asp-validation-for="StockQuantity" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="LowStockThreshold" class="form-label"></label>
                                <input asp-for="LowStockThreshold" class="form-control" type="number" min="0" step="1" />
                                <span asp-validation-for="LowStockThreshold" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="CategoryId" class="form-label"></label>
                                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId">
                                    <option value="">-- Select Category --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Niche" class="form-label"></label>
                                <input asp-for="Niche" class="form-control" />
                                <span asp-validation-for="Niche" class="text-danger"></span>
                            </div>
                            <input type="hidden" asp-for="ShopId" />
                        </div>

                        <hr class="my-4" style="border-color:#222;" />
                        <h5 class="fw-bold mb-3">Images</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6"><label asp-for="ImageUrl1" class="form-label">Image 1</label><input asp-for="ImageUrl1" class="form-control" /></div>
                            <div class="col-md-6"><label asp-for="ImageUrl2" class="form-label">Image 2</label><input asp-for="ImageUrl2" class="form-control" /></div>
                            <div class="col-md-6"><label asp-for="ImageUrl3" class="form-label">Image 3</label><input asp-for="ImageUrl3" class="form-control" /></div>
                            <div class="col-md-6"><label asp-for="ImageUrl4" class="form-label">Image 4</label><input asp-for="ImageUrl4" class="form-control" /></div>
                            <div class="col-md-6"><label asp-for="ImageUrl5" class="form-label">Image 5</label><input asp-for="ImageUrl5" class="form-control" /></div>
                        </div>

                        <hr class="my-4" style="border-color:#222;" />
                        <h5 class="fw-bold mb-3">Specifications</h5>
                        <div id="specsContainer" class="mb-3">
                            @foreach (var spec in Model.Specifications ?? Enumerable.Empty<ProductSpecification>())
                            {
                                <div class="row g-2 mb-2 spec-row">
                                    <div class="col-5"><input type="text" name="specKeys" class="form-control spec-key" value="@spec.Key" /></div>
                                    <div class="col-5"><input type="text" name="specValues" class="form-control spec-value" value="@spec.Value" /></div>
                                    <div class="col-2"><button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="removeSpecRow(this)">x</button></div>
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm mb-4" onclick="addSpecRow()">+ Add Spec</button>

                        <hr class="my-4" style="border-color:#222;" />
                        <h5 class="fw-bold mb-3">Colors</h5>
                        <div id="colorsContainer" class="mb-3">
                            @foreach (var color in Model.Colors ?? Enumerable.Empty<ProductColor>())
                            {
                                <div class="row g-2 mb-2 color-row">
                                    <div class="col-8"><input type="text" name="colors" class="form-control color-input" value="@color.ColorName" /></div>
                                    <div class="col-4"><button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="removeColorRow(this)">x</button></div>
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm mb-4" onclick="addColorRow()">+ Add Color</button>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-dark">Save</button>
                            <a asp-controller="Orders" asp-action="Dashboard" class="btn btn-outline-secondary">Back</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
