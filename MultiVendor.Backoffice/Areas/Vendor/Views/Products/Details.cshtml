@model MultiVendor.Core.Models.Product

@{
    ViewData["Title"] = Model.Name;
    var specs = Model.Specifications ?? Enumerable.Empty<ProductSpecification>();
    var colors = Model.Colors ?? Enumerable.Empty<ProductColor>();
}

<section class="section">
    <a asp-action="Index" class="btn btn-outline-secondary mb-3">&larr; Back to Products</a>

    <div class="row g-4">
        <div class="col-md-5">
            @if (!string.IsNullOrEmpty(Model.ImageUrl1))
            {
                <img src="@Model.ImageUrl1" class="img-fluid rounded" style="width:100%;max-height:400px;object-fit:cover;" alt="@Model.Name" />
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center rounded" style="width:100%;height:400px;background:linear-gradient(135deg,#1a1a1a,#2a2a2a);color:#555;font-size:4rem;font-weight:600;">
                    @(!string.IsNullOrEmpty(Model.Name) ? Model.Name[0].ToString().ToUpper() : "?")
                </div>
            }
        </div>
        <div class="col-md-7">
            <h1 style="font-size:1.75rem; font-weight:500; color:#fff;">@Model.Name</h1>
            <p style="font-size:1.25rem; font-weight:700; color:#b1b8a5; margin-top:0.5rem;">$@Model.Price.ToString("0.00")</p>

            <div class="mb-3">
                <span class="badge bg-@(Model.ModerationStatus == "Approved" ? "success" : Model.ModerationStatus == "Rejected" ? "danger" : "warning")">@Model.ModerationStatus</span>
                <span class="badge bg-secondary">@Model.Category?.Name</span>
            </div>

            <p style="color:#aaa; line-height:1.7; margin-top:1rem;">@Model.Description</p>

            <div class="row g-3 mt-2">
                <div class="col-md-4">
                    <div class="card" style="background:#0a0a0a; border-color:#222;">
                        <div class="card-body">
                            <div style="color:#888; font-size:0.85rem;">Stock</div>
                            <div style="font-size:1.25rem; font-weight:600; color:#fff;">@Model.StockQuantity</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card" style="background:#0a0a0a; border-color:#222;">
                        <div class="card-body">
                            <div style="color:#888; font-size:0.85rem;">Low Stock Threshold</div>
                            <div style="font-size:1.25rem; font-weight:600; color:#fff;">@Model.LowStockThreshold</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card" style="background:#0a0a0a; border-color:#222;">
                        <div class="card-body">
                            <div style="color:#888; font-size:0.85rem;">Shop</div>
                            <div style="font-size:1.1rem; font-weight:600; color:#fff;">@Model.Shop?.Name</div>
                        </div>
                    </div>
                </div>
            </div>

            @if (specs.Any())
            {
                <div class="mt-4">
                    <h5 style="font-weight:600; color:#fff; margin-bottom:1rem;">Specifications</h5>
                    <div class="card" style="background:#0a0a0a; border-color:#222;">
                        <div class="card-body p-0">
                            <table class="table mb-0" style="color:#e0e0e0;">
                                <tbody>
                                    @foreach (var spec in specs)
                                    {
                                        <tr style="border-color:#222;">
                                            <td style="color:#888; width:30%;">@spec.Key</td>
                                            <td style="color:#fff; font-weight:500;">@spec.Value</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            @if (colors.Any())
            {
                <div class="mt-4">
                    <h5 style="font-weight:600; color:#fff; margin-bottom:1rem;">Available Colors</h5>
                    <div class="d-flex gap-2 flex-wrap">
                        @foreach (var color in colors)
                        {
                            <span class="badge" style="background:#222; color:#e0e0e0; padding:0.5rem 1rem; border-radius:8px; border:1px solid #333;">@color.ColorName</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>
