@model IEnumerable<MultiVendor.Core.Models.Product>?

@{
    ViewData["Title"] = "My Products";
}

<section class="section">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0" style="font-size:1.75rem; font-weight:500;">My Products</h1>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#importModal">Import CSV</button>
            <a asp-action="ExportCsv" class="btn btn-outline-secondary btn-sm">Export CSV</a>
            <a asp-action="Create" class="btn btn-dark">Add Product</a>
        </div>
    </div>

    @if (TempData["ProductMessage"] != null)
    {
        <div class="alert alert-dark">@TempData["ProductMessage"]</div>
    }

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(p.ImageUrl1))
                                            {
                                                <img src="@p.ImageUrl1" style="width:40px;height:40px;object-fit:cover;border-radius:6px;" />
                                            }
                                            <div>
                                                <div style="font-weight:600;color:#fff;">@p.Name</div>
                                                <div style="font-size:0.8rem;color:#888;">@p.Shop?.Name</div>
    </div>
</div>

<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background:#141414; color:#e0e0e0; border:1px solid #222;">
            <div class="modal-header" style="border-color:#222;">
                <h5 class="modal-title" style="color:#fff;">Import Products from CSV</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ImportCsv" method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select CSV File</label>
                        <input type="file" name="file" accept=".csv" class="form-control" required />
                        <div class="form-text" style="color:#888;">Format: Id,Name,Description,Price,StockQuantity,LowStockThreshold,CategoryId,CategoryName,ShopId</div>
                    </div>
                </div>
                <div class="modal-footer" style="border-color:#222;">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark">Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

                                    </td>
                                    <td>@p.Category?.Name</td>
                                    <td>$@p.Price.ToString("0.00")</td>
                                    <td>
                                        @if (p.StockQuantity <= p.LowStockThreshold)
                                        {
                                            <span style="color:#dc3545;">@p.StockQuantity</span>
                                        }
                                        else
                                        {
                                            <span>@p.StockQuantity</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-@(p.ModerationStatus == "Approved" ? "success" : p.ModerationStatus == "Rejected" ? "danger" : "warning")">@p.ModerationStatus</span></td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4" style="color:#888;">No products found. Add your first product to get started.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
