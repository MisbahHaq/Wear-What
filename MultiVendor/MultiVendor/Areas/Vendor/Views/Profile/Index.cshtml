@model VendorProfilePageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Shop Profile";
    var shop = Model?.Shop;
    var products = Model?.Products ?? new List<MultiVendor.DTOs.ProductDto>();
}

@if (ViewBag.NoShop ?? false || shop is null)
{
    <div class="container-fluid">
        <div class="alert alert-info">
            <h4>No shop yet</h4>
            <p>You haven't created a shop. <a asp-controller="Shops" asp-action="Create" class="alert-link">Create one now</a>.</p>
        </div>
    </div>
    return;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1>@shop!.Name</h1>
            <p class="text-muted mb-1">@shop.Description</p>
            <small class="text-muted">Created @shop.CreatedAt:yyyy MMM dd · @shop.FollowerCount followers · @shop.ProductCount products</small>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <h3 class="mb-3">Your Products</h3>

    @if (!products.Any())
    {
        <div class="alert alert-light border">No products yet. Use the form below to add your first product.</div>
    }
    else
    {
        <table class="table table-hover shadow-sm mb-5">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in products)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>$@p.Price.ToString("F2")</td>
                        <td>@p.Stock</td>
                        <td>@p.Category</td>
                        <td>@(p.IsActive ? "Active" : "Inactive")</td>
                        <td class="text-end">
                            <form asp-area="Vendor" asp-controller="Products" asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this product?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <hr class="my-5" />
    <h3 class="mb-3">Add New Product</h3>

    <form asp-action="AddProduct" method="post" class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label">Product Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Sku" class="form-label">SKU</label>
            <input asp-for="Sku" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="ShortDescription" class="form-label">Short Description</label>
            <input asp-for="ShortDescription" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label">Full Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>
        <div class="col-md-4">
            <label asp-for="Price" class="form-label">Price ($)</label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Stock" class="form-label">Stock</label>
            <input asp-for="Stock" class="form-control" type="number" />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Category" class="form-label">Category</label>
            <input asp-for="Category" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="CoverImageUrl" class="form-label">Cover Image URL</label>
            <input asp-for="CoverImageUrl" class="form-control" />
        </div>
        <div class="col-12">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-success">Save Product</button>
        </div>
    </form>
</div>
