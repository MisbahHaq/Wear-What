@model MultiVendor.DTOs.CreateProductDto
@{
    Layout = "_Layout";
    ViewData["Title"] = "Add Product";
}

<div class="container-fluid">
    <h1 class="mb-4">Add Product</h1>

    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">Product Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Sku" class="form-label">SKU</label>
                <input asp-for="Sku" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="ShortDescription" class="form-label">Short Description</label>
                <input asp-for="ShortDescription" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label">Full Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-md-4">
                <label asp-for="Price" class="form-label">Price ($)</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Stock" class="form-label">Stock</label>
                <input asp-for="Stock" class="form-control" type="number" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Category" class="form-label">Category</label>
                <input asp-for="Category" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="CoverImageUrl" class="form-label">Cover Image URL</label>
                <input asp-for="CoverImageUrl" class="form-control" />
            </div>
            <div class="col-12">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-success me-2">Save Product</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </form>
</div>
