@model dynamic
@{
    Layout = "_Layout";
    ViewData["Title"] = "Shop Order Details";
}

<div class="vendor-shell">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1>@Model.ShopOrderNumber</h1>
            <p class="text-muted">Master order @Model.ParentOrderNumber · @Model.ParentOrderStatus</p>
        </div>
        <span class="badge bg-primary fs-6">@Model.Status</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3>Customer</h3>
                    <p><strong>@Model.CustomerName</strong></p>
                    <p class="text-muted">@Model.CustomerEmail</p>
                    <h3 class="mt-4">Items</h3>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Qty</th>
                                <th class="text-end">Unit</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@item.Quantity</td>
                                    <td class="text-end">$@item.UnitPrice.ToString("F2")</td>
                                    <td class="text-end">$@item.TotalPrice.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3>Shipping</h3>
                    <p>@Model.ShippingAddress</p>
                    <hr />
                    <div class="d-flex justify-content-between fs-4">
                        <strong>Total</strong>
                        <strong>$@Model.TotalAmount.ToString("F2")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
