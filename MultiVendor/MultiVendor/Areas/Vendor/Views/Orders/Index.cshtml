@model IEnumerable<dynamic>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Shop Orders";
}

<div class="vendor-shell">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Shop Orders</h1>
            <p class="text-muted mb-0">Orders assigned to your shop.</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No orders yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Vendor Order</th>
                        <th>Customer</th>
                        <th>Status</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>
                                <strong>@order.VendorOrderNumber</strong>
                                <div class="small text-muted">Master @order.MasterOrderNumber</div>
                            </td>
                            <td>@order.CustomerName</td>
                            <td><span class="badge bg-primary">@order.Status</span></td>
                            <td>@order.ItemCount</td>
                            <td>$@order.TotalAmount.ToString("F2")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@order.ShopOrderId" class="btn btn-sm btn-outline-primary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
