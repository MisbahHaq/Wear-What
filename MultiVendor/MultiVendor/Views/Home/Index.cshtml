@model HomePageViewModel
@{
    ViewData["Title"] = "MultiVendor Marketplace";
}

<div class="hero-section mb-4">
    <div class="container">
        <h1 class="display-4 fw-bold">Shop thousands of products from independent sellers</h1>
        <p class="lead mb-4">Browse shops, follow your favorites, and checkout across multiple vendors in one order.</p>
        <a asp-controller="Product" asp-action="Index" class="btn btn-warning btn-lg">Start Shopping</a>
        <a asp-controller="Home" asp-action="BrowseShops" class="btn btn-outline-light btn-lg ms-2">Browse Shops</a>
    </div>
</div>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Featured Shops</h2>
        <a asp-controller="Home" asp-action="BrowseShops" class="text-decoration-none">See all</a>
    </div>
    <div class="row g-3">
        @foreach (var shop in Model.FeaturedShops)
        {
            <div class="col-md-4">
                <div class="card h-100 shop-card shadow-sm">
                    @if (!string.IsNullOrEmpty(shop.BannerUrl))
                    {
                        <img src="@shop.BannerUrl" class="card-img-top" alt="@shop.Name" style="height:120px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height:120px;">
                            <span class="fs-1">@shop.Name.Substring(0, 1).ToUpper()</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@shop.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">@shop.Description</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <small>@shop.FollowerCount followers · @shop.ProductCount products</small>
                            <a asp-controller="Shops" asp-action="Details" asp-route-id="@shop.Id" class="btn btn-sm btn-outline-primary">Visit</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>New Arrivals</h2>
        <a asp-controller="Product" asp-action="Index" class="text-decoration-none">View all products</a>
    </div>
    <div class="row g-3">
        @foreach (var product in Model.NewArrivals)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                @await Html.PartialAsync("_ProductCard", product)
            </div>
        }
    </div>
</section>
