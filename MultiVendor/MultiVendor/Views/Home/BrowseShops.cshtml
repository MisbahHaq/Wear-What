@model List<MultiVendor.DTOs.ShopDto>
@{
    ViewData["Title"] = "Browse Shops";
}

<div class="container py-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary mb-3">← Back to Home</a>
    <h2 class="mb-4">All Shops</h2>

    <div class="row g-4">
        @foreach (var shop in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(shop.LogoUrl))
                    {
                        <img src="@shop.LogoUrl" class="card-img-top" alt="@shop.Name" style="height:160px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height:160px;">
                            <span class="fs-2">@shop.Name.Substring(0,1).ToUpper()</span>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@shop.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">@shop.Description</p>
                        <small class="text-muted">@shop.FollowerCount followers · @shop.ProductCount products</small>
                        <a asp-controller="Shop" asp-action="GetProducts" asp-route-id="@shop.Id" class="btn btn-sm btn-primary mt-2">View Shop</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
