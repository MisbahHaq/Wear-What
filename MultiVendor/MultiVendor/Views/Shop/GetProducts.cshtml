@model List<MultiVendor.DTOs.ProductDto>
@{
    ViewData["Title"] = ViewBag.Shop.Name;
    var shop = (MultiVendor.DTOs.ShopDto)ViewBag.Shop;
}

<div class="container py-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary mb-3">← Back to Home</a>

    <div class="card mb-4 shadow-sm">
        @if (!string.IsNullOrEmpty(shop.LogoUrl))
        {
            <img src="@shop.LogoUrl" class="card-img-top" alt="@shop.Name" style="height:200px;object-fit:cover;" />
        }
        <div class="card-body">
            <h2 class="card-title">@shop.Name</h2>
            <p class="text-muted">by @shop.OwnerName</p>
            <p class="card-text">@shop.Description</p>
            <small class="text-muted">@shop.FollowerCount followers · @shop.ProductCount products</small>
        </div>
    </div>

    <h3 class="mb-3">Products</h3>

    @if (!Model.Any())
    {
        <p class="text-muted">No products in this shop yet.</p>
    }

    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(product.CoverImageUrl))
                    {
                        <img src="@product.CoverImageUrl" class="card-img-top" alt="@product.Name" style="height:200px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center" style="height:200px;">
                            <span class="text-muted">No image</span>
                        </div>
                    }
                    <div class="card-body">
                        <h6 class="card-title text-truncate">@product.Name</h6>
                        <p class="fw-bold text-primary">$@product.Price.ToString("F2")</p>
                        @if (product.Stock > 0)
                        {
                            <span class="badge bg-success">In Stock</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Out of Stock</span>
                        }
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary w-100">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
