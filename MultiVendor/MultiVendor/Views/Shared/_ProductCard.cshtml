@model ProductDto
<div class="card h-100 product-card shadow-sm">
    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        <img src="@Model.CoverImageUrl" class="card-img-top product-image" alt="@Model.Name" />
    }
    else
    {
        <div class="product-placeholder">No image</div>
    }
    <div class="card-body d-flex flex-column">
        <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-dark">
            <h6 class="card-title product-title">@Model.Name</h6>
        </a>
        <p class="text-muted small mb-1">by @Model.ShopName</p>
        <p class="price-large text-primary">$@Model.Price.ToString("F2")</p>
        <p class="card-text small text-muted flex-grow-1">@Model.ShortDescription</p>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="badge @(Model.Stock > 0 ? "bg-success" : "bg-danger")">@(Model.Stock > 0 ? $"In Stock ({Model.Stock})" : "Out of Stock")</span>
            <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">View</a>
        </div>
    </div>
</div>
