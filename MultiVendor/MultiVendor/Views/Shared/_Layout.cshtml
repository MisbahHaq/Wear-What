<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MultiVendor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="amazon-header sticky-top">
        <div class="container-fluid px-3 py-2">
            <div class="row g-2 align-items-center">
                <div class="col-auto">
                    <a class="brand-mark" asp-controller="Home" asp-action="Index">MultiVendor</a>
                </div>
                <div class="col-12 col-lg-7">
                    <form asp-controller="Product" asp-action="Index" method="get" class="search-box">
                        <input type="search" name="search" class="form-control" placeholder="Search products, shops, categories" value="@Context.Request.Query["search"]" />
                        <button class="btn btn-warning" type="submit">Search</button>
                    </form>
                </div>
                <div class="col col-lg-3 d-flex justify-content-end gap-2">
                    <a asp-controller="Cart" asp-action="Index" class="cart-link">
                        Cart
                        <span class="badge rounded-pill text-bg-warning text-dark">
                            @await Component.InvokeAsync("CartCount")
                        </span>
                    </a>
                </div>
            </div>
        </div>
        <div class="border-top border-secondary py-1">
            <div class="container-fluid px-3 d-flex gap-3 small">
                <a class="link-light text-decoration-none" asp-controller="Product" asp-action="Index">All</a>
                <a class="link-light text-decoration-none" asp-controller="Home" asp-action="BrowseShops">Shops</a>
                <a class="link-light text-decoration-none" asp-controller="Home" asp-action="FollowedFeed">Following</a>
                <a class="link-light text-decoration-none" asp-controller="Cart" asp-action="MyOrders">Orders</a>
                @if (User.IsInRole("Vendor") || User.IsInRole("Admin"))
                {
                    <a class="link-light text-decoration-none" asp-area="Vendor" asp-controller="Dashboard" asp-action="Index">Seller Central</a>
                }
                else
                {
                    <a class="link-light text-decoration-none" asp-controller="Shops" asp-action="Create">Sell on MultiVendor</a>
                }
            </div>
        </div>
    </header>

    <main class="marketplace-bg">
        <div class="container py-4">
            @if (TempData["Success"] is not null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] is not null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="amazon-footer mt-5 py-4">
        <div class="container text-center text-light">
            © 2026 MultiVendor Marketplace
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
