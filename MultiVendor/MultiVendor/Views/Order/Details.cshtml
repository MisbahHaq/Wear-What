@model MultiVendor.Models.Order
@{
    ViewData["Title"] = $"Order {Model.OrderNumber}";
}

<h1>Order @Model.OrderNumber</h1>

<div class="row g-4">
    <div class="col-lg-8">
        @foreach (var shopOrder in Model.ShopOrders)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>@shopOrder.Shop.Name</strong>
                    <span>@shopOrder.VendorOrderNumber</span>
                </div>
                <div class="card-body">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Qty</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in shopOrder.OrderItems)
                            {
                                <tr>
                                    <td>@item.ProductNameSnapshot</td>
                                    <td>@item.Quantity</td>
                                    <td class="text-end">$@item.UnitPrice.ToString("F2")</td>
                                    <td class="text-end">$@item.LineTotal.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Shop Total</th>
                                <th class="text-end">$@shopOrder.VendorTotal.ToString("F2")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3>Order Summary</h3>
                <p><strong>Status:</strong> @Model.Status</p>
                <p><strong>Shipping Address:</strong><br />@Model.ShippingAddress</p>
                <hr />
                <div class="d-flex justify-content-between">
                    <span>Subtotal</span>
                    <strong>$@Model.SubTotal.ToString("F2")</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Shipping</span>
                    <strong>$@Model.ShippingAmount.ToString("F2")</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between fs-4">
                    <strong>Total</strong>
                    <strong>$@Model.GrandTotal.ToString("F2")</strong>
                </div>
            </div>
        </div>
    </div>
</div>
