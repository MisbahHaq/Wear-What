@model IReadOnlyList<ShopDto>
@{
    ViewData["Title"] = "Shops";
}

<h1>Browse Shops</h1>
<p class="text-muted">Discover independent sellers and follow shops to personalize your feed.</p>

<div class="row g-4">
    @foreach (var shop in Model)
    {
        <div class="col-md-4">
            <div class="card h-100 shop-card shadow-sm">
                @if (!string.IsNullOrEmpty(shop.BannerUrl))
                {
                    <img src="@shop.BannerUrl" class="card-img-top" alt="@shop.Name" style="height:140px;object-fit:cover;" />
                }
                else
                {
                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height:140px;">
                        <span class="fs-1">@shop.Name.Substring(0, 1).ToUpper()</span>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">@shop.Name</h5>
                    <p class="text-muted small">@shop.Description</p>
                    <p class="small mb-2">@shop.FollowerCount followers · @shop.ProductCount products</p>
                    <div class="d-flex gap-2">
                        <a asp-controller="Shops" asp-action="Details" asp-route-id="@shop.Id" class="btn btn-sm btn-primary flex-grow-1">Visit Shop</a>
                        @if (shop.IsFollowing)
                        {
                            <span class="btn btn-sm btn-success">Following</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
