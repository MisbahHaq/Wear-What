@model ShopDto
@{
    ViewData["Title"] = Model.Name;
    var products = ViewBag.Products as IReadOnlyList<ProductDto> ?? new List<ProductDto>();
}

<div class="card shadow-sm overflow-hidden">
    @if (!string.IsNullOrEmpty(Model.BannerUrl))
    {
        <img src="@Model.BannerUrl" class="w-100" alt="@Model.Name" style="max-height:220px;object-fit:cover;" />
    }
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-3">
            <div>
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(Model.LogoUrl))
                    {
                        <img src="@Model.LogoUrl" class="rounded-circle" width="72" height="72" alt="@Model.Name" />
                    }
                    <div>
                        <h1>@Model.Name</h1>
                        <p class="text-muted mb-0">@Model.Description</p>
                    </div>
                </div>
            </div>
            <div class="text-end">
                <div class="fs-4 fw-bold">@Model.FollowerCount</div>
                <small class="text-muted">followers</small>
                <div class="mt-2">
                    @if (Model.IsFollowing)
                    {
                        <form asp-controller="Shops" asp-action="Unfollow" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-success">Following</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Shops" asp-action="Follow" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-warning">Follow Shop</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <h2>Products from this shop</h2>
    <div class="row g-3">
        @foreach (var product in products)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                @await Html.PartialAsync("_ProductCard", product)
            </div>
        }
    </div>
</div>
