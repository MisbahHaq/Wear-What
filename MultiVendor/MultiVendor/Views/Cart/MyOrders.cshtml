@model IReadOnlyList<dynamic>
@{
    ViewData["Title"] = "My Orders";
}

<h1>My Orders</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">You have not placed any orders yet.</div>
}
else
{
    <div class="row g-3">
        @foreach (var order in Model)
        {
            <div class="col-12">
                <div class="card shadow-sm order-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h3>Order @order.OrderNumber</h3>
                                <p class="text-muted mb-1">@order.OrderDate</p>
                                <span class="badge bg-primary">@order.Status</span>
                            </div>
                            <div class="text-end">
                                <div class="fs-4 fw-bold">$@order.GrandTotal.ToString("F2")</div>
                                <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">View Details</a>
                            </div>
                        </div>
                        <p class="mb-1"><strong>Shops:</strong> @order.ShopCount</p>
                        <p class="mb-0"><strong>Items:</strong> @order.ItemCount</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
