@model CartViewModel
@{
    ViewData["Title"] = "Checkout";
}

<h1>Checkout</h1>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Checkout" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <h3>Shipping Address</h3>
                    <div class="mb-3">
                        <label for="ShippingAddress" class="form-label">Full shipping address</label>
                        <textarea id="ShippingAddress" name="ShippingAddress" class="form-control" rows="4" required></textarea>
                    </div>

                    <h3 class="mt-4">Review Items</h3>
                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex justify-content-between border-bottom py-2">
                            <div>
                                <strong>@item.ProductName</strong>
                                <div class="small text-muted">Qty @item.Quantity · Sold by @item.ShopName</div>
                            </div>
                            <strong>$@item.LineTotal.ToString("F2")</strong>
                        </div>
                    }
                    <button type="submit" class="btn btn-warning btn-lg w-100 mt-4">Place Order</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3>Order Total</h3>
                <div class="d-flex justify-content-between">
                    <span>Subtotal</span>
                    <strong>$@Model.Subtotal.ToString("F2")</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Shipping</span>
                    <strong>@(Model.Shipping == 0 ? "Free" : $"${Model.Shipping.ToString("F2")}")</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between fs-4">
                    <strong>Total</strong>
                    <strong>$@Model.GrandTotal.ToString("F2")</strong>
                </div>
            </div>
        </div>
    </div>
</div>
