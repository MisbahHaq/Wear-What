@model IReadOnlyList<ProductDto>
@{
    ViewData["Title"] = "Products";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var search = ViewBag.Search as string;
    var category = ViewBag.Category as string;
    var shopId = ViewBag.ShopId as int?;
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Products</h1>
        <p class="text-muted mb-0">Search, compare, and add items from multiple shops to one cart.</p>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-controller="Product" asp-action="Index" method="get" class="row g-3">
            <div class="col-md-6">
                <input name="search" class="form-control" placeholder="Search products" value="@search" />
            </div>
            <div class="col-md-3">
                <select name="category" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var item in categories)
                    {
                        <option value="@item" selected="@(item == category)">@item</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-grid">
                <button class="btn btn-primary" type="submit">Apply Filters</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No products found.</div>
}
else
{
    <div class="row g-3">
        @foreach (var product in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                @await Html.PartialAsync("_ProductCard", product)
            </div>
        }
    </div>

    <nav class="mt-4" aria-label="Product pages">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : null)">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@search" asp-route-category="@category" asp-route-shopId="@shopId">@i</a>
                </li>
            }
        </ul>
    </nav>
}
