@model MultiVendor.DTOs.ProductDto
@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Products</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="card shadow-sm order-card">
        <div class="row g-0">
            <div class="col-md-5">
                @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                {
                    <img src="@Model.CoverImageUrl" class="img-fluid w-100 product-detail-image" alt="@Model.Name" />
                }
                else
                {
                    <div class="product-placeholder product-detail-placeholder">No image</div>
                }
            </div>
            <div class="col-md-7">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h1 class="h2">@Model.Name</h1>
                            <p class="text-muted">Sold by <a asp-controller="Shops" asp-action="Details" asp-route-id="@Model.ShopId">@Model.ShopName</a></p>
                        </div>
                        <span class="badge @(Model.Stock > 0 ? "bg-success" : "bg-danger") fs-6">
                            @(Model.Stock > 0 ? $"In Stock ({Model.Stock})" : "Out of Stock")
                        </span>
                    </div>

                    <h2 class="text-primary my-3 price-large">$@Model.Price.ToString("F2")</h2>

                    @if (!string.IsNullOrEmpty(Model.ShortDescription))
                    {
                        <p class="lead">@Model.ShortDescription</p>
                    }

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p>@Model.Description</p>
                    }

                    <hr />

                    @if (Model.Stock > 0)
                    {
                        <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex align-items-center gap-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" class="form-control" style="width:100px;" />
                            <button type="submit" class="btn btn-warning btn-lg">Add to Cart</button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg" disabled>Out of Stock</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
