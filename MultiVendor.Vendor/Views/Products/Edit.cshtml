@model MultiVendor.Core.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<h1>Edit Product</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StockQuantity" class="control-label"></label>
                <input asp-for="StockQuantity" class="form-control" type="number" min="0" step="1" />
                <span asp-validation-for="StockQuantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LowStockThreshold" class="control-label"></label>
                <input asp-for="LowStockThreshold" class="form-control" type="number" min="0" step="1" />
                <span asp-validation-for="LowStockThreshold" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CategoryId" class="control-label"></label>
                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId">
                    <option value="">-- Select Category --</option>
                </select>
            </div>
            <input type="hidden" asp-for="ShopId" />
            <div class="form-group">
                <label asp-for="Niche" class="control-label"></label>
                <input asp-for="Niche" class="form-control" />
                <span asp-validation-for="Niche" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl1" class="control-label">Image URL 1 <span class="text-muted">(optional)</span></label>
                <input asp-for="ImageUrl1" class="form-control" placeholder="https://example.com/image1.jpg" />
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl2" class="control-label">Image URL 2 <span class="text-muted">(optional)</span></label>
                <input asp-for="ImageUrl2" class="form-control" placeholder="https://example.com/image2.jpg" />
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl3" class="control-label">Image URL 3 <span class="text-muted">(optional)</span></label>
                <input asp-for="ImageUrl3" class="form-control" placeholder="https://example.com/image3.jpg" />
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl4" class="control-label">Image URL 4 <span class="text-muted">(optional)</span></label>
                <input asp-for="ImageUrl4" class="form-control" placeholder="https://example.com/image4.jpg" />
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl5" class="control-label">Image URL 5 <span class="text-muted">(optional)</span></label>
                <input asp-for="ImageUrl5" class="form-control" placeholder="https://example.com/image5.jpg" />
            </div>

            <div class="form-group mt-4">
                <label class="control-label fw-bold">Product Specifications</label>
                <p class="text-muted small">Add key-value pairs like Brand: Apple, etc.</p>
                <div id="specsContainer">
                    @if (Model.Specifications != null && Model.Specifications.Any())
                    {
                        foreach (var spec in Model.Specifications)
                        {
                            <div class="row g-2 mb-2 spec-row">
                                <div class="col-5">
                                    <input type="text" name="specKeys" class="form-control spec-key" value="@spec.Key" />
                                </div>
                                <div class="col-5">
                                    <input type="text" name="specValues" class="form-control spec-value" value="@spec.Value" />
                                </div>
                                <div class="col-2">
                                    <button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="removeSpecRow(this)">×</button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="row g-2 mb-2 spec-row">
                            <div class="col-5">
                                <input type="text" name="specKeys" class="form-control spec-key" placeholder="e.g. Brand" />
                            </div>
                            <div class="col-5">
                                <input type="text" name="specValues" class="form-control spec-value" placeholder="e.g. Apple" />
                            </div>
                            <div class="col-2">
                                <button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="removeSpecRow(this)">×</button>
                            </div>
                        </div>
                    }
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm mt-2" onclick="addSpecRow()">+ Add Another Specification</button>
            </div>

            <div class="form-group mt-4">
                <label class="control-label fw-bold">Available Colors</label>
                <p class="text-muted small">Select the colors available for this product.</p>
                <div id="colorsContainer">
                    @if (Model.Colors != null && Model.Colors.Any())
                    {
                        foreach (var color in Model.Colors)
                        {
                            <div class="row g-2 mb-2 color-row">
                                <div class="col-8">
                                    <input type="text" name="colors" class="form-control color-input" value="@color.ColorName" />
                                </div>
                                <div class="col-4">
                                    <button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="removeColorRow(this)">×</button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="row g-2 mb-2 color-row">
                            <div class="col-8">
                                <input type="text" name="colors" class="form-control color-input" placeholder="e.g. Red" />
                            </div>
                            <div class="col-4">
                                <button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="removeColorRow(this)">×</button>
                            </div>
                        </div>
                    }
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm mt-2" onclick="addColorRow()">+ Add Another Color</button>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function addSpecRow() {
            var container = document.getElementById('specsContainer');
            var row = document.createElement('div');
            row.className = 'row g-2 mb-2 spec-row';
            row.innerHTML = `
                <div class="col-5">
                    <input type="text" name="specKeys" class="form-control spec-key" placeholder="e.g. Brand" />
                </div>
                <div class="col-5">
                    <input type="text" name="specValues" class="form-control spec-value" placeholder="e.g. Apple" />
                </div>
                <div class="col-2">
                    <button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="removeSpecRow(this)">×</button>
                </div>
            `;
            container.appendChild(row);
        }

        function removeSpecRow(btn) {
            var container = document.getElementById('specsContainer');
            if (container.children.length > 1) {
                btn.closest('.spec-row').remove();
            }
        }

        function addColorRow() {
            var container = document.getElementById('colorsContainer');
            var row = document.createElement('div');
            row.className = 'row g-2 mb-2 color-row';
            row.innerHTML = `
                <div class="col-8">
                    <input type="text" name="colors" class="form-control color-input" placeholder="e.g. Red" />
                </div>
                <div class="col-4">
                    <button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="removeColorRow(this)">×</button>
                </div>
            `;
            container.appendChild(row);
        }

        function removeColorRow(btn) {
            var container = document.getElementById('colorsContainer');
            if (container.children.length > 1) {
                btn.closest('.color-row').remove();
            }
        }
    </script>
}


