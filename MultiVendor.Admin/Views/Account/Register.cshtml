@model MultiVendor.Admin.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "_Layout"; // Make sure your layout file doesn't override backgrounds, or use an empty/blank template for auth screens
}

<style>
    /* Full screen container setup matching the sage/olive background border look */
    html, body {
        margin: 0;
        padding: 0;
        background-color: #000000;
        overflow-x: hidden;
    }

    .auth-outer-wrapper {
        background-color: #000000;
        min-height: 100vh;
        display: flex;
        align-items: stretch;
        justify-content: center;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .auth-card {
        background-color: #000000;
        border-radius: 0;
        overflow: hidden;
        width: 100%;
        max-width: 1100px;
        min-height: 100vh;
        box-shadow: none;
        display: flex;
    }

    /* Left panel with background image overlay and typography styling */
    .auth-banner-side {
        position: relative;
        background: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80') center center no-repeat;
        background-size: cover;
        min-height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 3rem 2.5rem;
    }

    .auth-banner-side::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0.4) 100%);
        z-index: 1;
    }

    .auth-banner-content {
        position: relative;
        z-index: 2;
        color: #ffffff;
    }

    .auth-banner-content h2 {
        font-size: 1.6rem;
        font-weight: 400;
        line-height: 1.4;
        margin-bottom: 0.5rem;
        letter-spacing: -0.5px;
    }

    .auth-banner-content p {
        color: #b0b5a5;
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    /* Right panel form inputs and UI design styling */
    .auth-form-side {
        padding: 3rem 3.5rem;
        color: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 100%;
    }

    .auth-form-side h1 {
        font-size: 1.75rem;
        font-weight: 500;
        margin-bottom: 0.75rem;
        letter-spacing: -0.5px;
    }

    .auth-subtitle {
        color: #888888;
        font-size: 0.9rem;
        line-height: 1.5;
        margin-bottom: 2.5rem;
    }

    .auth-form-side .form-label {
        color: #aaaaaa;
        font-size: 0.8rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .auth-form-side .form-control {
        background-color: #141414;
        border: 1px solid #222222;
        color: #ffffff;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 0.9rem;
    }

    .auth-form-side .form-control:focus {
        background-color: #141414;
        border-color: #a3a899; /* Highlight active input border color matching the theme */
        box-shadow: none;
        color: #ffffff;
    }

    .auth-form-side .form-control::placeholder {
        color: #444444;
    }

    .password-hint {
        color: #555555;
        font-size: 0.75rem;
        margin-top: 0.5rem;
    }

    .btn-create-account {
        background-color: #b1b8a5; /* Signature muted green main action button */
        color: #1c2017;
        font-weight: 600;
        border: none;
        border-radius: 8px;
        padding: 0.8rem;
        width: 100%;
        font-size: 0.95rem;
        margin-top: 1.5rem;
        transition: background-color 0.2s ease;
    }

    .btn-create-account:hover {
        background-color: #c2c9b6;
        color: #1c2017;
    }

    .auth-footer-text {
        text-align: center;
        font-size: 0.8rem;
        color: #666666;
        margin-top: 2rem;
    }

    .auth-footer-text a {
        color: #ffffff;
        text-decoration: none;
    }

    .auth-footer-text a:hover {
        text-decoration: underline;
    }

    .terms-text {
        font-size: 0.7rem;
        color: #444444;
        text-align: center;
        margin-top: 3rem;
    }
    
    .terms-text a {
        color: #888888;
        text-decoration: none;
    }
    .vendor-fields {
        display: none;
    }
</style>

<script>
    function toggleVendorFields() {
        var role = document.getElementById('userRole').value;
        var vendorFields = document.getElementById('vendorFields');
        if (role === 'Vendor') {
            vendorFields.style.display = 'block';
            $('#ShopName').prop('disabled', false);
            $('#CNIC').prop('disabled', false);
            $('#ContactNumber').prop('disabled', false);
        } else {
            vendorFields.style.display = 'none';
            $('#ShopName').prop('disabled', true);
            $('#CNIC').prop('disabled', true);
            $('#ContactNumber').prop('disabled', true);
        }
    }

    $(document).ready(function() {
        toggleVendorFields();
        console.log('[Register] Page loaded. UserRole:', $('#userRole').val());
    });

    $('#registerForm').submit(function(e) {
        var role = $('#userRole').val();
        console.log('[Register] Form submitting. UserRole:', role);
        if (role !== 'Vendor') {
            $('#ShopName').prop('disabled', true);
            $('#CNIC').prop('disabled', true);
            $('#ContactNumber').prop('disabled', true);
            console.log('[Register] Disabled vendor fields for Customer');
        }
    });
</script>

<div class="auth-outer-wrapper">
    <div class="auth-card">
        <div class="row g-0">
            <div class="col-lg-5 d-none d-lg-flex">
                <div class="auth-banner-side w-100">
                    <div class="auth-banner-content">
                        <h2>Design your future, one blueprint at a time.<br>Join a community of architects shaping tomorrow.</h2>
                        <p>Structura — Your gateway to architectural excellence.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-7 col-12">
                <div class="auth-form-side">
                    <h1>Create your account</h1>
                    <p class="auth-subtitle">Join a network of visionaries and unlock premium design resources tailored for you.</p>

                    <form asp-action="Register" method="post" id="registerForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="UserRole" class="form-label">I want to sign up as *</label>
                            <select asp-for="UserRole" class="form-control" id="userRole" onchange="toggleVendorFields()">
                                <option value="Customer">Customer</option>
                                <option value="Vendor">Vendor / Shop Owner</option>
                            </select>
                            <span asp-validation-for="UserRole" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">Full name *</label>
                            <input asp-for="FullName" class="form-control" placeholder="Andrew Thomas" autofocus />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email address *</label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="e.g. andrew@@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-2">
                            <div class="col-6">
                                <label asp-for="Password" class="form-label">Password</label>
                                <input asp-for="Password" class="form-control" type="password" placeholder="••••••••••••" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                        <p class="password-hint">Password must be at least 8 characters, including a number and a special character.</p>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">Address</label>
                            <input asp-for="Address" class="form-control" placeholder="e.g. 123 Main St, City" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="vendor-fields" id="vendorFields">
                            <div class="mb-3">
                                <label asp-for="ShopName" class="form-label">Shop name *</label>
                                <input asp-for="ShopName" class="form-control" placeholder="e.g. My Awesome Shop" />
                                <span asp-validation-for="ShopName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="CNIC" class="form-label">CNIC *</label>
                                <input asp-for="CNIC" class="form-control" placeholder="e.g. 12345-6789012-3" />
                                <span asp-validation-for="CNIC" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ContactNumber" class="form-label">Contact number *</label>
                                <input asp-for="ContactNumber" class="form-control" placeholder="e.g. +92 300 1234567" />
                                <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-create-account">Create account</button>

                        <div class="auth-footer-text">
                            Already have an account? <a href="/Account/Login">Sign In</a>
                        </div>

                        <div class="terms-text">
                            By creating an account, you agree to our <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

