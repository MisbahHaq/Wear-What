@model MultiVendor.Core.Models.ProductComment

@{
    ViewData["Title"] = "Delete Comment";
}

<h1>Delete Comment</h1>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this comment?</h4>
</div>

<div class="card">
    <div class="card-body">
        <h5>@Model.User?.FullName</h5>
        <p>@Model.Content</p>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-outline-danger" />
    <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary">Cancel</a>
</form>
