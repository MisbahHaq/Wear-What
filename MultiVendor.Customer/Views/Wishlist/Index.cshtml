@model IEnumerable<MultiVendor.Core.Models.WishlistItem>

@{
    ViewData["Title"] = "My Wishlist";
}

<h1>My Wishlist</h1>

@if (!Model.Any())
{
    <div class="alert">Your wishlist is empty. <a asp-controller="Products" asp-action="Index">Browse products</a> to add items.</div>
}
else
{
    <div class="product-grid">
    @foreach (var item in Model)
    {
        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="product-card text-decoration-none">
            @if (item.Product != null && !string.IsNullOrEmpty(item.Product.ImageUrl1))
            {
                <img src="@item.Product.ImageUrl1" class="product-card-image" alt="@item.Product.Name" />
            }
            else
            {
                 <div class="product-card-image-placeholder">@(!string.IsNullOrEmpty(item.Product?.Name) ? item.Product.Name[0].ToString().ToUpper() : "?")</div>
            }
            <div class="product-card-body">
                <div class="product-card-title">@item.Product?.Name ?? "Unknown Product"</div>
                <div class="product-card-price">$@item.Product?.Price.ToString("0.00")</div>
                <div class="product-card-shop">@item.Product?.Shop?.Name</div>
                <div class="d-flex gap-2 mt-2">
                    <span class="btn btn-outline-primary btn-sm product-card-btn flex-fill">View</span>
                    <form asp-controller="Wishlist" asp-action="Remove" method="post" class="flex-fill" asp-antiforgery="true">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">Remove</button>
                    </form>
                </div>
            </div>
        </a>
    }
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

