<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Shop</a>

                <div class="search-wrapper d-none d-md-flex">
                    <form class="search-input-group" asp-controller="Products" asp-action="Index" method="get" autocomplete="off">
                        <input type="text" id="searchInput" name="searchString" placeholder="Search products..." value="@Context.Request.Query["searchString"]" autocomplete="off" />
                        <button type="submit">Search</button>
                        <div id="searchSuggestions" class="search-suggestions"></div>
                    </form>
                </div>

<div class="d-flex align-items-center gap-3">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="nav-link" href="http://localhost:5001/Admin/Admin">Admin</a>
                            }
                            @if (!User.IsInRole("Vendor"))
                            {
                                <a class="nav-link position-relative" asp-controller="Wishlist" asp-action="Index">
                                    Wishlist
                                </a>
                            }
                            <a class="nav-link position-relative profile-icon-link" asp-controller="Profile" asp-action="Index" title="Profile">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            </a>
                            @if (!User.IsInRole("Vendor"))
                            {
                                <partial name="_NotificationDropdown" />
                            }
                        }
                       else
                       {
                           <a class="nav-link" asp-controller="Account" asp-action="Login">Sign In</a>
                           <a class="nav-link d-none d-sm-inline" asp-controller="Account" asp-action="Register">Register</a>
                        }
                        @if (User?.Identity?.IsAuthenticated == true && !User.IsInRole("Vendor"))
                        {
                            <a class="nav-link position-relative" asp-controller="Cart" asp-action="Index" id="cartNavLink">
                                Cart
                                <span id="cartBadge" class="cart-badge d-none">0</span>
                            </a>
                        }
                  </div>
            </div>
        </nav>

    </header>

    <div class="container" style="max-width: 1400px;">
        <main role="main" class="py-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer-section">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <h5>Shop</h5>
                    <p class="footer-text">Your one-stop marketplace for everything. Quality products, great prices.</p>
                </div>
                <div class="footer-col">
                    <h5>Browse</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Products" asp-action="Index">All Products</a></li>
                        <li><a asp-controller="Shops" asp-action="Index">Shops</a></li>
                        <li><a asp-controller="Categories" asp-action="Index">Categories</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h5>Account</h5>
                    <ul class="footer-links">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <li><a asp-controller="Profile" asp-action="Index">Profile</a></li>
                            @if (!User.IsInRole("Vendor"))
                            {
                                <li><a asp-controller="Wishlist" asp-action="Index">Wishlist</a></li>
                                <li><a asp-controller="Cart" asp-action="Index">Cart</a></li>
                            }
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutFormFooter" class="d-inline">
                                    <button type="submit" class="btn btn-link p-0">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li><a asp-controller="Account" asp-action="Login">Sign In</a></li>
                            <li><a asp-controller="Account" asp-action="Register">Register</a></li>
                            <li><a asp-controller="Cart" asp-action="Index">Cart</a></li>
                        }
                    </ul>
                </div>
                <div class="footer-col">
                    <h5>Support</h5>
                    <ul class="footer-links">
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li><a href="#!">Terms of Service</a></li>
                        <li><a href="#!">Contact Us</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; 2026 - Shop. All rights reserved.</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var input = document.getElementById('searchInput');
            var box = document.getElementById('searchSuggestions');
            if (!input || !box) return;

            var debounce;
            input.addEventListener('input', function () {
                var term = input.value.trim();
                clearTimeout(debounce);
                if (term.length < 1) { box.style.display = 'none'; box.innerHTML = ''; return; }
                debounce = setTimeout(function () {
                    fetch('/Products/Suggest?term=' + encodeURIComponent(term))
                        .then(function (r) { return r.json(); })
                        .then(function (items) {
                            if (!items.length) { box.style.display = 'none'; box.innerHTML = ''; return; }
                            box.innerHTML = items.map(function (it) {
                                var img = it.image
                                    ? '<img src="' + it.image + '" alt="" />'
                                    : '<div class="ss-noimg">?</div>';
                                var price = (it.price != null) ? '$' + Number(it.price).toFixed(2) : '';
                                return '<a class="ss-item" href="/Products/Details/' + it.id + '">' +
                                    '<div class="ss-thumb">' + img + '</div>' +
                                    '<div class="ss-info"><div class="ss-name">' + it.name + '</div>' +
                                    '<div class="ss-meta">' + (it.shop || '') + (price ? ' &middot; ' + price : '') + '</div></div>' +
                                    '</a>';
                            }).join('');
                            box.style.display = 'block';
                        })
                        .catch(function () { box.style.display = 'none'; });
                }, 200);
            });

            input.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') { box.style.display = 'none'; }
            });

            input.addEventListener('blur', function () {
                setTimeout(function () { box.style.display = 'none'; }, 150);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

