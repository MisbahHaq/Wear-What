@model IEnumerable<MultiVendor.Core.Models.UserAddress>

@{
    ViewData["Title"] = "Your Addresses";
}

<h1 class="fw-bold">@ViewData["Title"]</h1>

@if (TempData["AddressMessage"] != null)
{
    <div class="alert alert-dark">@TempData["AddressMessage"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Add Address</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Address</th>
            <th>City</th>
            <th>State</th>
            <th>Zip</th>
            <th>Default</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.AddressLine</td>
                <td>@a.City</td>
                <td>@a.State</td>
                <td>@a.ZipCode</td>
                <td>@(a.IsDefault ? "Yes" : "No")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                    <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this address?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

