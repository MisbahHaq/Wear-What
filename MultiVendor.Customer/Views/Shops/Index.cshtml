@model IEnumerable<MultiVendor.Core.Models.ShopItem>

@{
    ViewData["Title"] = "Shops";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Shops</h1>
    @if (User?.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary">Create Shop</a>
    }
</div>

<div class="shop-grid">
@foreach (var item in Model)
{
    <a asp-action="Details" asp-route-id="@item.Id" class="shop-card text-decoration-none">
        @if (!string.IsNullOrEmpty(item.ProfileBannerUrl))
        {
            <img src="@item.ProfileBannerUrl" class="shop-card-banner" alt="Banner" />
        }
        else
        {
            <div class="shop-card-banner-placeholder"></div>
        }
        <div class="card-body text-center">
            @if (!string.IsNullOrEmpty(item.ProfileImageUrl))
            {
                <img src="@item.ProfileImageUrl" alt="@item.Name profile" class="shop-card-avatar" />
            }
            else
            {
                <div class="shop-card-avatar-placeholder">@item.Name[0]</div>
            }
            <h5 class="card-title mt-2">@item.Name</h5>
            <p class="card-text text-muted">@item.Description</p>
            <p class="card-text text-muted">Products: @(item.Products?.Count ?? 0)</p>
            <span class="btn btn-outline-primary btn-sm">View Shop</span>
        </div>
    </a>
}
</div>

