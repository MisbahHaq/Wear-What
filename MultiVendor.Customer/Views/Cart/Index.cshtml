@model List<CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
    var subtotal = Model.Sum(i => i.Price * i.Quantity);
}

<div class="cart-page">
    <h1 class="cart-title">Shopping Cart</h1>

    @if (TempData["CartMessage"] != null)
    {
        <div class="alert alert-dark cart-alert">@TempData["CartMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="cart-empty">
            <p>Your cart is empty.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-dark mt-3">Continue Shopping</a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-items">
                @foreach (var item in Model)
                {
                    <div class="cart-item">
                        <div class="cart-item-image">
                            <img src="@item.ImageUrl" alt="@item.ProductName" />
                        </div>
                        <div class="cart-item-details">
                            <h5 class="cart-item-name">@item.ProductName</h5>
                            <p class="cart-item-shop">@item.ShopName</p>
                            <p class="cart-item-price">$@item.Price.ToString("0.00")</p>
                        </div>
                        <div class="cart-item-quantity">
                            <form asp-action="Update" method="post" class="d-inline">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="99" class="cart-qty-input" onchange="this.form.submit()" />
                            </form>
                        </div>
                        <div class="cart-item-total">
                            $@((item.Price * item.Quantity).ToString("0.00"))
                        </div>
                        <div class="cart-item-actions">
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="cart-remove-btn">&times;</button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <div class="cart-summary">
                <h5 class="cart-summary-title">Order Summary</h5>
                <div class="cart-summary-row">
                    <span>Subtotal</span>
                    <span>$@subtotal.ToString("0.00")</span>
                </div>
                <div class="cart-summary-row">
                    <span>Shipping</span>
                    <span class="text-muted">Calculated at checkout</span>
                </div>
                <hr />
                <div class="cart-summary-row cart-summary-total">
                    <span>Total</span>
                    <span>$@subtotal.ToString("0.00")</span>
                </div>
                <a asp-controller="Orders" asp-action="CheckoutCart" class="btn btn-dark w-100 mt-3">Proceed to Checkout</a>
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-dark w-100 mt-2">Continue Shopping</a>
            </div>
        </div>
    }
</div>

